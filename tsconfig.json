{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext", "es2022", "webworker"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "verbatimModuleSyntax": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@src/*": ["./src/*"],
      "@utils/*": ["./scripts/utils/*"],
      "lib/*": ["./lib/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": ".",
    "allowImportingTsExtensions": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/types/*.d.ts",
    "src/lib/types/global.d.ts",
    "src/lib/types/modules.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/**/*",
    "!.next/types/**/*.ts",
    "out",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/dist/**",
    "src/lib/types/generated/**"
  ]
}
