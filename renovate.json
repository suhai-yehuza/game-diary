{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "schedule:weekly",
    ":preserveSemverRanges",
    ":maintainLockFilesWeekly",
    ":enableVulnerabilityAlertsWithLabel(security)",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeType": "pr",
      "requiredStatusChecks": ["test", "lint"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "requiredStatusChecks": ["test", "lint"]
    },
    {
      "matchPackageNames": ["next", "react", "react-dom"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackagePatterns": ["^@types/"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchPackagePatterns": ["^@testing-library/"],
      "groupName": "testing libraries",
      "automerge": true
    },
    {
      "matchPackagePatterns": ["^@graphql/"],
      "groupName": "graphql packages",
      "automerge": true
    },
    {
      "matchPackagePatterns": ["^@radix-ui/"],
      "groupName": "radix ui packages",
      "automerge": true
    },
    {
      "matchPackagePatterns": ["^eslint"],
      "groupName": "eslint packages",
      "automerge": true
    },
    {
      "matchPackagePatterns": ["^@typescript-eslint/"],
      "groupName": "typescript-eslint packages",
      "automerge": true
    },
    {
      "matchPackagePatterns": ["^tailwind"],
      "groupName": "tailwind packages",
      "automerge": true
    },
    {
      "matchPackagePatterns": ["^drizzle"],
      "groupName": "drizzle packages",
      "automerge": true
    },
    {
      "matchPackagePatterns": ["^@apollo/"],
      "groupName": "apollo packages",
      "automerge": true
    }
  ],
  "labels": ["dependencies", "renovate"],
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "rangeStrategy": "bump",
  "bumpVersion": "patch",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "repositories": ["."],
  "onboarding": false,
  "requireConfig": true,
  "baseBranches": ["main"],
  "assignees": [],
  "reviewers": [],
  "assigneesSampleSize": 1,
  "reviewersSampleSize": 1,
  "stabilityDays": 3,
  "prCreation": "not-pending",
  "ignoreDeps": [],
  "ignorePaths": [],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "assignees": [],
    "reviewers": [],
    "schedule": "at any time"
  },
  "schedule": ["before 3am on monday"],
  "timezone": "UTC",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on monday"]
  },
  "postUpdateOptions": ["pnpmDedupe", "pnpmInstall"],
  "pnpm": {
    "enabled": true
  }
}
