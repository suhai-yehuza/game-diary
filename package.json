{
  "name": "game-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x.0",
    "pnpm": "10.x.0"
  },
  "scripts": {
    "=====Development=====": "=====+=====+=====+=====+=====",
    "dev": "next dev --turbo -p ${PORT:-3100}",
    "dev:staging": "NODE_ENV=staging next dev --turbo -p ${PORT:-3101}",
    "start": "next start",
    "start:staging": "NODE_ENV=staging next start",
    "build": "next build",
    "build:staging": "NODE_ENV=staging next build",
    "prebuild": "pnpm clean:all && pnpm codegen && pnpm fix && pnpm validate:dev",
    "=====Timing Wrapper=====": "=====+=====+=====+=====+=====",
    "timed": "./scripts/timed-run.sh script",
    "=====Cleanup=====": "=====+=====+=====+=====+=====",
    "clean": "rimraf .next out coverage dist playwright-report .nyc_output src/lib/types/generated tests-results",
    "clean:cache": "rm -rf .next/cache .eslintcache && pnpm clean",
    "clean:deps": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml && pnpm install",
    "clean:all": "pnpm clean && pnpm clean:deps && pnpm clean:cache",
    "clean:build": "pnpm clean:build:dev",
    "clean:build:dev": "./scripts/validation-run.sh staging",
    "clean:build:prod": "./scripts/validation-run.sh production",
    "=====Code Quality=====": "=====+=====+=====+=====+=====",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:staged": "lint-staged",
    "typecheck": "tsc --noEmit --incremental",
    "format:check": "prettier --check . --cache",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "fix:lint:format": "pnpm run lint:fix && pnpm run format",
    "fix:types": "tsx scripts/utils/fix-type-violations.ts",
    "fix": "pnpm run fix:lint:format && pnpm run validate:types:fix && pnpm run typecheck && pnpm run fix:lint:format",
    "=====Testing=====": "=====+=====+=====+=====+=====",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage && node scripts/print-coverage-link.cjs",
    "test:strict": "vitest run --reporter=verbose --coverage && node scripts/print-coverage-link.cjs",
    "test:unit": "vitest run --reporter=verbose --coverage",
    "test:all": "pnpm test:coverage && pnpm test:e2e:quickie",
    "test:all:strict": "pnpm test:strict && pnpm test:e2e:quickie",
    "=====E2E Testing=====": "=====+=====+=====+=====+=====",
    "test:e2e:mock-verification": "playwright test tests/e2e/functional/mock-verification.spec.ts --config=playwright.fast.config.ts",
    "test:e2e:quickie": "playwright test --grep @fast --config=playwright.fast.config.ts",
    "test:e2e:smoke": "playwright test tests/e2e/functional/smoke.spec.ts --config=playwright.fast.config.ts",
    "test:e2e:critical": "playwright test tests/e2e/functional/critical.spec.ts --config=playwright.popular.config.ts",
    "test:e2e:responsive": "playwright test tests/e2e/functional/responsive.spec.ts --config=playwright.popular.config.ts",
    "test:e2e:full": "playwright test tests/e2e/functional/full.spec.ts --config=playwright.popular.config.ts",
    "test:e2e:performance": "playwright test tests/e2e/functional/full.spec.ts --config=playwright.popular.config.ts --project=chromium --workers=1",
    "test:e2e:pages": "playwright test tests/e2e/pages/ --config=playwright.pages.config.ts",
    "test:e2e:pages:home": "playwright test tests/e2e/pages/home.spec.ts --config=playwright.pages.config.ts",
    "test:e2e:pages:navigation": "playwright test tests/e2e/pages/navigation.spec.ts --config=playwright.pages.config.ts",
    "test:e2e:pages:auth": "playwright test tests/e2e/pages/auth.spec.ts --config=playwright.pages.config.ts",
    "test:e2e:pages:dashboard": "playwright test tests/e2e/pages/dashboard.spec.ts --config=playwright.pages.config.ts",
    "test:e2e:pages:sports": "playwright test tests/e2e/pages/sports.spec.ts --config=playwright.pages.config.ts",
    "test:e2e:pages:cross-browser": "playwright test tests/e2e/pages/cross-browser.spec.ts --config=playwright.pages.config.ts",
    "test:e2e:compound": "./scripts/e2e-compound-runner.sh",
    "test:e2e:compound:quickie": "./scripts/e2e-compound-runner.sh --fast-only",
    "test:e2e:compound:smoke": "./scripts/e2e-compound-runner.sh --smoke-only",
    "test:e2e:compound:critical": "./scripts/e2e-compound-runner.sh --critical-only",
    "test:e2e:compound:responsive": "./scripts/e2e-compound-runner.sh --responsive-only",
    "test:e2e:compound:full": "./scripts/e2e-compound-runner.sh --full-only",
    "test:e2e:compound:mock-verification": "./scripts/e2e-compound-runner.sh --mock-verification-only",
    "test:e2e:smoke:deployed": "DEPLOYMENT_URL=$VERCEL_URL playwright test tests/e2e/functional/fast.spec.ts --config=playwright.smoke.config.ts",
    "test:e2e:pre-deploy": "pnpm test:e2e:responsive && pnpm test:e2e:performance",
    "test:e2e:post-deploy": "pnpm test:e2e:smoke:deployed",
    "test:e2e:load": "pnpm playwright test tests/e2e/functional/responsive.spec.ts --config=playwright.popular.config.ts --project=chromium --workers=3",
    "test:e2e:install-browsers": "npx playwright install --with-deps",
    "test:e2e:debug:ui": "pnpm playwright test --ui",
    "open:test:report": "pnpm exec playwright show-report",
    "=====Validation=====": "=====+=====+=====+=====+=====",
    "validate": "./scripts/validation-run.sh production",
    "validate:ci": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "validate:predeploy": "pnpm validate:ci && pnpm test:e2e:critical",
    "validate:all": "pnpm validate:ci && pnpm test:e2e:full",
    "validate:dev": "./scripts/validation-run.sh dev",
    "validate:staging": "./scripts/validation-run.sh staging",
    "validate:full": "./scripts/validation-run.sh full",
    "validate:with-size": "pnpm validate && pnpm check:size",
    "validate:types": "tsx scripts/utils/validate-types.ts",
    "validate:types:fix": "pnpm run validate:types && pnpm run fix:types",
    "verify": "./scripts/validation-run.sh basic",
    "=====Database=====": "=====+=====+=====+=====+=====",
    "db:copy-custom-migrations": "tsx scripts/db/copy-custom-migrations.ts",
    "db:generate": "rm -rf ./drizzle/* && drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "NODE_ENV=development tsx -r dotenv/config scripts/db/apply-migrations.ts development",
    "db:migrate:dry-run": "NODE_ENV=development tsx -r dotenv/config scripts/db/apply-migrations.ts development --dry-run",
    "db:migrate:prod": "NODE_ENV=production tsx -r dotenv/config scripts/db/apply-migrations.ts production",
    "db:migrate:staging": "NODE_ENV=staging tsx -r dotenv/config scripts/db/apply-migrations.ts staging",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:pull": "drizzle-kit pull:pg",
    "db:setup": "tsx scripts/db/setup-database.ts --mode=complete",
    "db:setup:dev": "NODE_ENV=development tsx scripts/db/setup-database.ts --mode=complete --environment=development",
    "db:setup:staging": "NODE_ENV=staging tsx scripts/db/setup-database.ts --mode=complete --environment=staging",
    "db:setup:prod": "NODE_ENV=production tsx scripts/db/setup-database.ts --mode=complete --environment=production",
    "db:setup:test": "NODE_ENV=development tsx scripts/db/setup-database.ts --mode=complete --environment=development --test",
    "db:studio": "drizzle-kit studio",
    "db:test-connection": "tsx scripts/test/test-db-connection.ts --mode=full",
    "db:triggers": "tsx scripts/db/setup-database.ts --mode=triggers-only",
    "db:triggers:dev": "NODE_ENV=development tsx scripts/db/setup-database.ts --mode=triggers-only --environment=development",
    "db:triggers:staging": "NODE_ENV=staging tsx scripts/db/setup-database.ts --mode=triggers-only --environment=staging",
    "db:triggers:prod": "NODE_ENV=production tsx scripts/db/setup-database.ts --mode=triggers-only --environment=production",
    "db:validate-migrations": "tsx scripts/db/validate-migrations.ts",
    "db:view-migrations": "tsx scripts/db/view-migrations.ts",
    "=====Code Generation=====": "=====+=====+=====+=====+=====",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "=====Analysis & Performance=====": "=====+=====+=====+=====+=====",
    "analyze": "ANALYZE=true next build",
    "analyze:bundle": "npx @next/bundle-analyzer",
    "check:circular": "tsx scripts/utils/check-circular-deps.ts",
    "check:size": "size-limit",
    "check:size:ci": "size-limit || echo 'Size check skipped in CI environment'",
    "check:unused:exports": "tsx scripts/utils/check-unused-exports.ts",
    "perf:build": "NODE_ENV=production ANALYZE=true next build",
    "perf:measure": "tsx scripts/performance/performance-measure.ts",
    "perf:report": "tsx scripts/performance/performance-report.ts",
    "perf:start": "NODE_ENV=production next start",
    "=====Dependencies=====": "=====+=====+=====+=====+=====",
    "deps:audit": "pnpm audit",
    "deps:check": "pnpm outdated",
    "deps:clean": "pnpm store prune",
    "deps:fix": "pnpm audit fix",
    "deps:interactive": "pnpm update -i",
    "deps:manage": "tsx scripts/utils/manage-deps.ts",
    "deps:update": "pnpm update --latest",
    "=====Git Hooks=====": "=====+=====+=====+=====+=====",
    "postinstall": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run typecheck && pnpm run test:strict",
    "verify-env": "tsx scripts/utils/verify-env.ts",
    "=====CI Pipeline Scripts=====": "=====+=====+=====+=====+=====",
    "ci:preview": "NODE_ENV=production ./scripts/ci-runner.sh preview",
    "ci:staging": "NODE_ENV=production ./scripts/ci-runner.sh staging",
    "ci:production": "NODE_ENV=production ./scripts/ci-runner.sh production",
    "=====Soak Period Scripts=====": "=====+=====+=====+=====+=====",
    "soak:start": "./scripts/soak-monitor.sh start",
    "soak:monitor": "./scripts/soak-monitor.sh monitor",
    "soak:rollback": "./scripts/soak-monitor.sh rollback",
    "soak:status": "./scripts/soak-monitor.sh status",
    "soak:test": "./scripts/soak-monitor.sh start staging 300 && ./scripts/soak-monitor.sh monitor staging 300",
    "=====Deployment Management=====": "=====+=====+=====+=====+=====",
    "deploy:auto": "./scripts/deployment-manager.sh auto-deploy",
    "deploy:auto:check": "./scripts/deployment-manager.sh auto-deploy check",
    "deploy:manual": "./scripts/deployment-manager.sh manual-deploy",
    "deploy:rollback": "./scripts/deployment-manager.sh rollback",
    "deploy:status": "./scripts/deployment-manager.sh status",
    "deploy:history": "./scripts/deployment-manager.sh history",
    "deploy:list": "./scripts/deployment-manager.sh list",
    "test:ci": "pnpm test:strict && pnpm test:e2e:quickie",
    "ci:quality-gate": "./scripts/ci-quality-gate.sh",
    "ci:unit-tests": "./scripts/ci-unit-tests.sh",
    "ci:e2e-tests": "./scripts/ci-e2e-tests.sh",
    "ci:e2e:run": "./scripts/e2e-run.sh basic 'playwright test --project=chromium' 'Chromium CI tests' 300",
    "ci:e2e:run:coverage": "./scripts/e2e-run.sh coverage 'playwright test tests/e2e/functional/fast.spec.ts' 'Fast E2E Coverage Tests'",
    "ci:e2e:run:coverage:full": "./scripts/e2e-run.sh coverage-full 'playwright test tests/e2e/functional/full.spec.ts' 'Full E2E Coverage Tests' 7200",
    "ci:e2e:responsive": "./scripts/e2e-run.sh responsive",
    "ci:e2e:debug": "./scripts/e2e-debug.sh",
    "=====Legacy CI Validation (Deprecated)=====": "=====+=====+=====+=====+=====",
    "ci:validation:basic": "./scripts/validation-run.sh basic",
    "ci:validation:dev": "./scripts/validation-run.sh dev",
    "ci:validation:full": "./scripts/validation-run.sh full",
    "ci:validation:staging": "./scripts/validation-run.sh staging",
    "ci:validation:production": "./scripts/validation-run.sh production",
    "=====Workflow Scripts=====": "=====+=====+=====+=====+=====",
    "push_and_merge": "./scripts/push-and-merge.sh",
    "push_and_merge:help": "./scripts/push-and-merge.sh --help",
    "=====Debug & Maintenance=====": "=====+=====+=====+=====+=====",
    "test:generate-results": "./scripts/generate-test-results.sh",
    "test:generate-results:quickie": "./scripts/generate-test-results.sh playwright.fast.config.ts",
    "test:generate-results:popular": "./scripts/generate-test-results.sh playwright.popular.config.ts",
    "test:generate-results:responsive": "./scripts/generate-test-results.sh playwright.popular.config.ts tests/e2e/functional/responsive.spec.ts",
    "test:failing": "./scripts/run-failing.sh files",
    "test:failing:quickie": "./scripts/run-failing.sh files playwright.fast.config.ts line",
    "test:failing:popular": "./scripts/run-failing.sh files playwright.popular.config.ts line",
    "test:failing:responsive": "./scripts/run-failing.sh files playwright.popular.config.ts line tests/e2e/functional/responsive.spec.ts",
    "=====Database Seeding=====": "=====+=====+=====+=====+=====",
    "seed": "tsx src/lib/db/seed/index.ts",
    "seed:help": "tsx src/lib/db/seed/index.ts --help",
    "seed:external": "tsx src/lib/db/seed/index.ts --external",
    "seed:user": "tsx src/lib/db/seed/index.ts --user",
    "seed:all": "tsx src/lib/db/seed/index.ts --all",
    "seed:clear-user": "tsx src/lib/db/seed/index.ts --clear-user",
    "seed:small": "tsx src/lib/db/seed/index.ts --scenario small",
    "seed:medium": "tsx src/lib/db/seed/index.ts --scenario medium",
    "seed:large": "tsx src/lib/db/seed/index.ts --scenario large",
    "seed:custom": "tsx src/lib/db/seed/index.ts --scenario custom",
    "seed:dry-run": "tsx src/lib/db/seed/index.ts --dry-run",
    "seed:validate": "tsx scripts/test-seeding-dependencies-simple.ts",
    "seed:test-cli": "tsx scripts/test-command-line-seeding.ts"
  },
  "dependencies": {
    "@apollo/client": "3.13.8",
    "@apollo/server": "4.12.2",
    "@as-integrations/next": "3.2.0",
    "@auth/drizzle-adapter": "1.9.1",
    "@auth/upstash-redis-adapter": "2.9.1",
    "@clerk/backend": "2.3.0",
    "@clerk/nextjs": "6.23.2",
    "@graphql-tools/schema": "10.0.23",
    "@graphql-typed-document-node/core": "3.2.0",
    "@heroicons/react": "2.2.0",
    "@hookform/resolvers": "5.1.1",
    "@neondatabase/serverless": "1.0.1",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.12",
    "@tailwindcss/forms": "0.5.10",
    "@tanstack/react-query": "5.80.10",
    "@types/luxon": "3.6.2",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.35.0",
    "@vitest/coverage-v8": "3.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "compression": "1.8.0",
    "dataloader": "2.2.3",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.44.2",
    "drizzle-seed": "0.3.1",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "framer-motion": "12.19.2",
    "graphql-scalars": "1.24.2",
    "graphql-tag": "2.12.6",
