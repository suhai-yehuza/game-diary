    "react-loading-skeleton": "^3.5.0",
    "react-quill": "^2.0.0",
    "react-swipeable": "^7.0.2",
    "recharts": "^2.15.3",
    "sonner": "^2.0.4",
    "svix": "^1.64.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.0.4",
    "uuid": "^11.1.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@faker-js/faker": "^9.6.0",
    "@graphql-codegen/cli": "^5.0.6",
    "@graphql-codegen/schema-ast": "^4.1.0",
