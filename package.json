{
  "name": "game-diary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "clean": "rm -rf .next node_modules pnpm-lock.yaml package-lock.json tsconfig.tsbuildinfo src/lib/graphql/generated && rm -rf ./drizzle && mkdir -p ./drizzle && pnpm install",
    "clean:build": "pnpm clean && pnpm format && pnpm fix && pnpm validate:all && pnpm build && NODE_ENV=development && pnpm test:databases",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "db:fetch-games": "tsx ./src/lib/db/seed/fetch-external-api-games.ts",
    "db:fetch-games:dev": "tsx ./src/lib/db/seed/fetch-external-api-games.ts development",
    "db:fetch-games:prod": "tsx ./src/lib/db/seed/fetch-external-api-games.ts production",
    "db:generate": "rm -rf ./drizzle/* && drizzle-kit generate --config=drizzle.config.ts",
    "db:copy-custom-migrations": "tsx scripts/copy-custom-migrations.ts",
    "db:validate-migrations": "tsx scripts/validate-migrations.ts",
    "db:migrate": "pnpm db:validate-migrations && pnpm db:generate && pnpm db:copy-custom-migrations && pnpm db:push && tsx ./src/lib/db/seed/migrate.ts",
    "db:migrate:reset": "pnpm db:validate-migrations && pnpm db:generate && pnpm db:copy-custom-migrations && pnpm db:push && tsx ./src/lib/db/seed/migrate-reset.ts",
    "db:migrate:dev": "pnpm db:validate-migrations && pnpm db:generate && pnpm db:copy-custom-migrations && pnpm db:push && tsx ./src/lib/db/seed/migrate.ts development",
    "db:migrate:prod": "pnpm db:validate-migrations && pnpm db:generate && pnpm db:copy-custom-migrations && pnpm db:push && tsx ./src/lib/db/seed/migrate.ts production",
    "db:migrate:reset:dev": "pnpm db:validate-migrations && pnpm db:generate && pnpm db:copy-custom-migrations && pnpm db:push && tsx ./src/lib/db/seed/migrate-reset.ts development && tsx src/lib/db/seed/test-trigger.ts",
    "db:migrate:reset:prod": "pnpm db:validate-migrations && pnpm db:generate && pnpm db:copy-custom-migrations && pnpm db:push && tsx ./src/lib/db/seed/migrate-reset.ts production && tsx src/lib/db/seed/test-trigger.ts",
    "db:test-migrations": "tsx scripts/test-migrations.ts",
    "db:seed:optimized:dev": "pnpm db:migrate:dev && tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts",
    "db:append:seed:dev": "tsx --max-old-space-size=24576 src/lib/db/seed/append-seeder.ts",
    "db:seed:fast": "pnpm db:migrate:dev && tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --batchSize=1000 --concurrency=10",
    "db:seed:dev": "pnpm db:migrate:dev && tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --seasons=2024 --batchSize=200",
    "db:seed:reset": "pnpm db:migrate:reset:dev && tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --resetDb=true",
    "db:seed:prod": "NODE_ENV=production pnpm db:migrate:prod && tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --concurrency=20 --batchSize=500",
    "db:seed:test": "NODE_ENV=test pnpm db:migrate:dev && tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --seasons=2024 --batchSize=50 --concurrency=2",
    "db:seed:monitor": "pnpm db:migrate:dev && tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --enableMonitoring=true",
    "db:pull": "drizzle-kit pull:pg",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev && pnpm codegen:watch",
    "fix": "pnpm run lint:fix && pnpm run format && pnpm run typecheck",
    "fix-imports": "pnpm eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "start": "next start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:databases": "pnpm test:redis && pnpm test:neon-postgres",
    "test:redis": "tsx scripts/test-redis.ts",
    "test:neon-postgres": "tsx scripts/test-neon-postgres.ts",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm codegen  && pnpm prettier --write src/lib/graphql/schema.graphql && pnpm lint && pnpm fix-imports && pnpm format:check && pnpm typecheck && pnpm db:test-migrations",
    "validate:all": "pnpm run validate && pnpm run check:circular",
    "migration:generate": "tsx scripts/manage-migrations.ts generate",
    "migration:validate": "tsx scripts/manage-migrations.ts validate",
    "migration:reset": "pnpm clean:build && pnpm db:migrate:reset:dev"
  },
  "dependencies": {
    "@apollo/client": "^3.13.7",
    "@apollo/server": "4.12.1",
    "@as-integrations/next": "3.2.0",
    "@auth/drizzle-adapter": "^1.9.1",
    "@auth/upstash-redis-adapter": "^2.9.1",
    "@clerk/nextjs": "^6.14.3",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.3.4",
    "@neondatabase/serverless": "^1.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.13",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query": "^5.24.1",
    "@types/luxon": "^3.6.2",
    "@types/natural": "^5.1.5",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.28.4",
    "apollo-server-errors": "^3.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "dataloader": "^2.2.3",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "drizzle-seed": "^0.3.1",
    "emoji-picker-react": "^4.12.2",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "framer-motion": "^12.10.5",
    "graphql-constraint-directive": "^6.0.0",
    "graphql-scalars": "^1.24.2",
    "graphql-tag": "^2.12.6",
    "ioredis": "^5.6.1",
    "jose": "^6.0.10",
    "lucide-react": "^0.487.0",
    "luxon": "^3.6.1",
    "natural": "^8.0.1",
    "next": "^14.2.25",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "p-limit": "^6.2.0",
    "pg": "^8.11.12",
    "postgres": "^3.4.5",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-datepicker": "^8.3.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.1",
    "react-hot-toast": "^2.5.2",
    "react-loading-skeleton": "^3.5.0",
    "react-quill": "^2.0.0",
    "react-swipeable": "^7.0.2",
    "recharts": "^2.15.3",
    "svix": "^1.64.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.0.4",
    "uuid": "^11.1.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@faker-js/faker": "^9.6.0",
    "@graphql-codegen/cli": "^5.0.6",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-resolvers": "^4.5.1",
    "@graphql-tools/schema": "10.0.23",
    "@graphql-tools/utils": "10.8.6",
    "@next/env": "15.4.0-canary.51",
    "@parcel/watcher": "^2.5.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
