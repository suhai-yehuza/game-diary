{
  "name": "game-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "// Development": "Core development commands",
    "dev": "next dev --turbo",
    "build": "tsx scripts/utils/verify-env-build.ts && next build",
    "start": "next start",
    "clean": "rm -rf .next out coverage test-results-e2e playwright-report .nyc_output dist && mkdir -p coverage",
    "clean:deps": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml && pnpm install",
    "clean:cache": "rm -rf .next/cache .eslintcache && pnpm clean",
    "clean:all": "pnpm clean && pnpm clean:deps",
    "// Code Quality": "Linting, formatting, and type checking",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "typecheck": "tsc --noEmit --incremental",
    "fix": "pnpm run lint:fix && pnpm run format && pnpm run typecheck",
    "// Testing": "Test commands",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "trap 'kill $(lsof -t -i:8080) 2>/dev/null || true' EXIT; pnpm dev -p 8080 & wait-on http://localhost:8080 && playwright test",
    "test:e2e:ui": "trap 'kill $(lsof -t -i:8080) 2>/dev/null || true' EXIT; pnpm dev -p 8080 & wait-on http://localhost:8080 && playwright test --ui",
    "test:all-0": "pnpm test:coverage && pnpm test:e2e",
    "test:all": "echo 'test:all'",
    "// Database": "Database management commands",
    "db:setup": "tsx scripts/db/setup-database-complete.ts",
    "db:setup:dev": "tsx scripts/db/setup-database-complete.ts development",
    "db:setup:prod": "tsx scripts/db/setup-database-complete.ts production",
    "db:setup:test": "tsx scripts/db/setup-database-complete.ts development --test",
    "db:generate": "rm -rf ./drizzle/* && drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:pull": "drizzle-kit pull:pg",
    "db:studio": "drizzle-kit studio",
    "db:triggers": "tsx scripts/db/setup-database.ts",
    "db:triggers:dev": "tsx scripts/db/setup-database.ts development",
    "db:triggers:prod": "tsx scripts/db/setup-database.ts production",
    "db:seed:dev": "tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --seasons=2024 --batchSize=200",
    "db:seed:fast": "tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --batchSize=1000 --concurrency=10",
    "db:seed:prod": "NODE_ENV=production tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --concurrency=20 --batchSize=500",
    "db:seed:test": "NODE_ENV=test tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --seasons=2024 --batchSize=50 --concurrency=2",
    "db:seed:monitor": "tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --enableMonitoring=true",
    "db:fetch-games:dev": "tsx ./src/lib/db/seed/fetch-external-api-games.ts development",
    "db:fetch-games:prod": "tsx ./src/lib/db/seed/fetch-external-api-games.ts production",
    "db:migrate": "tsx scripts/db/apply-migrations.ts",
    "db:migrate:dev": "tsx scripts/db/apply-migrations.ts development",
    "db:migrate:prod": "tsx scripts/db/apply-migrations.ts production",
    "db:migrate:dry-run": "tsx scripts/db/apply-migrations.ts development --dry-run",
    "db:copy-custom-migrations": "tsx scripts/db/copy-custom-migrations.ts",
    "db:validate-migrations": "tsx scripts/db/validate-migrations.ts",
    "db:test-migrations": "tsx scripts/test/test-migrations.ts",
    "db:view-migrations": "tsx scripts/db/view-migrations.ts",
    "// GraphQL": "GraphQL code generation",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "schema:combine": "tsx --tsconfig tsconfig.scripts.json scripts/utils/combine-schema.ts",
    "// Analysis": "Code analysis and optimization",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:bundle": "npx @next/bundle-analyzer",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "check:unused:exports": "tsx scripts/check-unused-exports.ts",
    "check:size": "size-limit",
    "check:lighthouse": "lhci autorun",
    "// Performance": "Performance monitoring and optimization",
    "perf:build": "cross-env NODE_ENV=production ANALYZE=true next build",
    "perf:start": "cross-env NODE_ENV=production next start",
    "perf:measure": "tsx scripts/performance/performance-measure.ts",
    "perf:report": "tsx scripts/performance/performance-report.ts",
    "// Validation": "Comprehensive validation suite",
    "validate": "pnpm run schema:combine && pnpm run codegen && pnpm run format && pnpm run fix && pnpm run typecheck && pnpm run check:circular && pnpm run verify-env",
    "validate:full": "pnpm run validate && pnpm run check:unused:exports && pnpm run test:all && pnpm run check:size",
    "// Build": "Build variants and optimization",
    "prebuild": "pnpm clean:all && pnpm validate",
    "build:analyze": "cross-env ANALYZE=true pnpm build",
    "build:debug": "cross-env DEBUG=true pnpm build",
    "build:size": "pnpm build && npx size-limit",
    "clean:build": "pnpm prebuild && pnpm build && pnpm validate:full",
    "// Git Hooks": "Pre-commit and pre-push hooks",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run typecheck && pnpm run test:coverage",
    "verify-env": "tsx scripts/utils/verify-env.ts",
    "// Dependencies": "Dependency management commands",
    "deps:check": "pnpm outdated",
    "deps:update": "pnpm update --latest",
    "deps:clean": "pnpm store prune",
    "deps:audit": "pnpm audit",
    "deps:fix": "pnpm audit fix",
    "deps:interactive": "pnpm update -i",
    "deps:manage": "tsx scripts/utils/manage-deps.ts"
  },
