    "zod": "3.25.67"
  },
  "devDependencies": {
    "@babel/preset-typescript": "7.27.1",
    "@eslint/js": "9.29.0",
    "@faker-js/faker": "9.8.0",
    "@graphql-codegen/cli": "5.0.7",
    "@graphql-codegen/schema-ast": "4.1.0",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-graphql-request": "6.3.0",
    "@graphql-codegen/typescript-operations": "4.6.1",
    "@graphql-codegen/typescript-resolvers": "4.5.1",
    "@graphql-tools/utils": "10.8.6",
    "@next/bundle-analyzer": "15.3.4",
    "@next/eslint-plugin-next": "15.3.4",
    "@playwright/test": "1.53.1",
    "@size-limit/preset-app": "11.2.0",
    "@tailwindcss/postcss": "4.1.11",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "1.8.1",
    "@types/dotenv-flow": "3.3.3",
    "@types/express": "5.0.3",
    "@types/glob": "8.1.0",
    "@types/node": "24.0.7",
    "@types/pg": "8.15.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.35.0",
    "@typescript-eslint/parser": "8.35.0",
    "@typescript-eslint/utils": "8.35.0",
    "@vitest/ui": "3.2.4",
    "assert": "2.1.0",
    "autoprefixer": "10.4.21",
    "dotenv": "17.0.0",
    "dotenv-flow": "4.1.0",
    "drizzle-kit": "0.31.4",
    "esbuild": "^0.25.5",
    "eslint": "9.29.0",
    "eslint-config-next": "15.3.4",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "glob": "11.0.3",
    "globals": "16.2.0",
    "graphql": "16.11.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "16.1.2",
    "madge": "8.0.0",
    "node-fetch": "3.3.2",
    "path-browserify": "1.0.1",
    "postcss": "8.5.6",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.13",
    "process": "0.11.10",
    "rimraf": "^6.0.1",
    "size-limit": "11.2.0",
    "stream-browserify": "3.0.0",
    "stream-http": "3.2.0",
    "tailwindcss": "4.1.11",
    "ts-morph": "26.0.0",
    "ts-node": "10.9.2",
    "ts-prune": "0.10.3",
    "ts-unused-exports": "11.0.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "undici": "7.11.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4",
    "wait-on": "8.0.3"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "glob": "^11.0.0",
      "node-domexception": "^2.0.0",
      "@babel/plugin-proposal-class-properties": "npm:@babel/plugin-transform-class-properties@^7.27.1",
      "@babel/plugin-proposal-object-rest-spread": "npm:@babel/plugin-transform-object-rest-spread@^7.27.7",
      "@esbuild-kit/core-utils": "^3.3.2",
      "@esbuild-kit/esm-loader": "^2.6.5"
    }
  }
}
