{
  "name": "game-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x.0",
    "pnpm": "10.x.0"
  },
  "scripts": {
    "=====Development=====": "=====+=====+=====+=====+=====",
    "dev": "next dev --turbo -p ${PORT:-3000}",
    "dev:staging": "NODE_ENV=staging next dev --turbo -p ${PORT:-3001}",
    "start": "next start",
    "start:staging": "NODE_ENV=staging next start",
    "build": "next build",
    "build:staging": "NODE_ENV=staging next build",
    "prebuild": "pnpm clean:all && pnpm codegen && pnpm fix && pnpm validate:dev",
    "=====Timing Wrapper=====": "=====+=====+=====+=====+=====",
    "timed": "./scripts/timed-run.sh script",
    "=====Cleanup=====": "=====+=====+=====+=====+=====",
    "clean": "rimraf .next out coverage dist playwright-report .nyc_output src/lib/types/generated tests-results",
    "clean:cache": "rm -rf .next/cache .eslintcache && pnpm clean",
    "clean:deps": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml && pnpm install",
    "clean:all": "pnpm clean && pnpm clean:deps && pnpm clean:cache",
    "clean:build": "pnpm clean:build:dev && pnpm coverage:validate",
    "clean:build:dev": "./scripts/validation-run.sh staging",
    "clean:build:prod": "./scripts/validation-run.sh production",
    "=====Code Quality=====": "=====+=====+=====+=====+=====",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:staged": "lint-staged",
    "typecheck": "tsc --noEmit --incremental",
    "format:check": "prettier --check . --cache",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "fix:lint:format": "pnpm run lint:fix && pnpm run format",
    "fix:types": "tsx scripts/utils/fix-type-violations.ts",
    "fix": "pnpm run fix:lint:format && pnpm run validate:types:fix && pnpm run typecheck && pnpm run fix:lint:format",
    "=====Testing=====": "=====+=====+=====+=====+=====",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage && node scripts/print-coverage-link.cjs",
    "test:strict": "vitest run --reporter=verbose --coverage && node scripts/print-coverage-link.cjs",
    "test:unit": "vitest run --reporter=verbose --coverage",
    "test:unit:json": "vitest run --reporter=json --coverage",
    "coverage:enforce": "tsx scripts/coverage-enforcement.ts",
    "coverage:enforce:coverage": "tsx scripts/coverage-enforcement.ts --coverage-only",
    "coverage:enforce:test-count": "tsx scripts/coverage-enforcement.ts --test-count-only",
    "coverage:enforce:both": "tsx scripts/coverage-enforcement.ts --both",
    "coverage:validate": "pnpm test:unit && pnpm test:e2e:sanity && pnpm coverage:enforce",
    "pre-push:coverage": "./scripts/pre-push-coverage.sh",
    "pre-push:coverage:strict": "./scripts/pre-push-coverage.sh --unit-threshold=95 --e2e-threshold=90 --min-unit-tests=100 --min-e2e-tests=50",
    "pre-push:validation": "./scripts/pre-push-validation.sh",
    "pre-push:validation:fast": "PRE_PUSH_FAST=true ./scripts/pre-push-validation.sh",
    "pre-push:validation:no-e2e": "SKIP_E2E=true ./scripts/pre-push-validation.sh",
    "test:all": "pnpm test:coverage && pnpm test:e2e:sanity",
    "test:all:strict": "pnpm test:strict && pnpm test:e2e:sanity",
    "=====E2E Testing=====": "=====+=====+=====+=====+=====",
    "test:e2e:mock-verification": "PW_MODE=sanity playwright test tests/e2e/functional/mock-verification.spec.ts",
    "test:e2e:sanity": "PW_MODE=sanity playwright test tests/e2e/functional/sanity.spec.ts",
    "test:e2e:smoke": "PW_MODE=sanity playwright test tests/e2e/functional/smoke.spec.ts",
    "test:e2e:critical": "PW_MODE=critical PLAYWRIGHT_TEST=true playwright test tests/e2e/functional/critical.spec.ts",
    "test:e2e:navigation": "PW_MODE=critical PLAYWRIGHT_TEST=true playwright test tests/e2e/functional/navigation.spec.ts",
    "test:e2e:responsive": "PW_MODE=popular PLAYWRIGHT_TEST=true playwright test tests/e2e/functional/responsive.spec.ts",
    "test:e2e:cross-browser": "PW_MODE=popular PLAYWRIGHT_TEST=true playwright test tests/e2e/functional/cross-browser.spec.ts",
    "test:e2e:full": "PW_MODE=popular PLAYWRIGHT_TEST=true playwright test tests/e2e/functional/full.spec.ts",
    "test:e2e:performance": "PW_MODE=popular playwright test tests/e2e/functional/full.spec.ts --project=chromium --workers=1",
    "test:e2e:pages": "PW_MODE=pages playwright test tests/e2e/pages/",
    "test:e2e:pages:content": "PW_MODE=pages playwright test tests/e2e/pages/content-page.spec.ts",
    "test:e2e:pages:home": "PW_MODE=pages playwright test tests/e2e/pages/home.spec.ts",
    "test:e2e:pages:dashboard": "PW_MODE=pages playwright test tests/e2e/pages/dashboard.spec.ts",
    "test:e2e:pages:sports": "PW_MODE=pages playwright test tests/e2e/pages/sports.spec.ts",
    "test:e2e:pages:auth": "PW_MODE=pages playwright test tests/e2e/pages/clerk-auth.spec.ts",
    "test:e2e:smoke:deployed": "PW_MODE=smoke DEPLOYMENT_URL=$VERCEL_URL playwright test tests/e2e/functional/smoke.spec.ts",
    "test:e2e:pre-deploy": "pnpm test:e2e:critical && pnpm test:e2e:performance",
    "test:e2e:post-deploy": "pnpm test:e2e:smoke:deployed",
    "test:e2e:load": "PW_MODE=popular pnpm playwright test tests/e2e/functional/responsive.spec.ts --project=chromium --workers=3",
    "test:e2e:install-browsers": "pnpm playwright install --with-deps",
    "test:e2e:fix-browsers": "./scripts/fix-playwright-browsers.sh",
    "test:e2e:fix-browsers:force": "./scripts/fix-playwright-browsers.sh --force",
    "test:e2e:debug:ui": "pnpm playwright test --ui",
    "test:e2e:all": "pnpm test:e2e:full && pnpm test:e2e:pages",
    "test:e2e:all:fast": "pnpm test:e2e:smoke && pnpm test:e2e:pages",
    "open:test:report": "pnpm exec playwright show-report",
    "=====Validation=====": "=====+=====+=====+=====+=====",
    "validate:ci": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm db:test:all-triggers",
    "validate:predeploy": "pnpm validate:ci && pnpm test:e2e:critical",
    "validate:all": "pnpm validate:ci && pnpm test:e2e:full",
    "validate:with-size": "pnpm validate && pnpm check:size",
    "validate:types:fix": "pnpm run fix:types",
    "verify": "pnpm validate:basic",
    "=====Code Generation=====": "=====+=====+=====+=====+=====",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "=====Analysis & Performance=====": "=====+=====+=====+=====+=====",
    "analyze": "ANALYZE=true next build",
    "analyze:bundle": "pnpm @next/bundle-analyzer",
    "check:circular": "tsx scripts/utils/check-circular-deps.ts",
    "check:size": "size-limit",
    "check:size:ci": "size-limit || echo 'Size check skipped in CI environment'",
    "check:unused:exports": "tsx scripts/utils/check-unused-exports.ts",
    "perf:build": "NODE_ENV=production ANALYZE=true next build",
    "perf:measure": "tsx scripts/performance/performance-measure.ts",
    "perf:report": "tsx scripts/performance/performance-report.ts",
    "perf:start": "NODE_ENV=production next start",
    "=====Dependencies=====": "=====+=====+=====+=====+=====",
    "deps:audit": "pnpm audit",
    "deps:check": "pnpm outdated",
    "deps:clean": "pnpm store prune",
    "deps:fix": "pnpm audit fix",
    "deps:interactive": "pnpm update -i",
    "deps:manage": "tsx scripts/utils/manage-deps.ts",
    "deps:update": "pnpm update --latest",
    "=====Git Hooks=====": "=====+=====+=====+=====+=====",
    "postinstall": "husky",
    "pre-commit": "echo 'Pre-commit validation is now handled by scripts/db/pre-commit-validation.sh'",
    "verify-env": "tsx scripts/utils/verify-env.ts",
    "=====Consolidated Scripts=====": "=====+=====+=====+=====+=====",
    "e2e": "./scripts/e2e.sh",
    "e2e:run": "./scripts/e2e.sh run",
    "e2e:debug": "./scripts/e2e.sh debug",
    "e2e:optimize": "./scripts/e2e.sh optimize",
    "e2e:coverage": "./scripts/e2e.sh coverage",
    "e2e:responsive": "./scripts/e2e.sh responsive",
    "ci": "./scripts/ci.sh",
    "ci:run": "./scripts/ci.sh run",
    "ci:quality-gate": "./scripts/ci.sh quality-gate",
    "ci:unit-tests": "./scripts/ci.sh unit-tests",
    "ci:e2e-tests": "./scripts/ci.sh e2e-tests",
    "ci:preview": "./scripts/ci.sh preview",
    "ci:staging": "./scripts/ci.sh staging",
    "ci:production": "./scripts/ci.sh production",
    "ci:prod:local:dry-run": "./scripts/deployment-validator.sh dry-run",
    "ci:prod:dry-run": "CI=true ./scripts/deployment-validator.sh dry-run",
    "ci:prod:local:dry-run:fast": "./scripts/deployment-validator.sh dry-run --fast",
    "ci:prod:dry-run:fast": "CI=true ./scripts/deployment-validator.sh dry-run --fast",
    "ci:prod:local:pre-deploy": "./scripts/deployment-validator.sh pre-deploy",
    "ci:prod:pre-deploy": "CI=true ./scripts/deployment-validator.sh pre-deploy",
    "ci:prod:local:post-deploy": "./scripts/deployment-validator.sh post-deploy",
    "ci:prod:post-deploy": "CI=true ./scripts/deployment-validator.sh post-deploy",
    "ci:prod:local:validation": "./scripts/deployment-validator.sh ci",
    "ci:prod:validation": "CI=true ./scripts/deployment-validator.sh ci",
    "validate": "./scripts/validate.sh",
    "validate:basic": "./scripts/validate.sh basic",
    "validate:dev": "./scripts/validate.sh dev",
    "validate:full": "./scripts/validate.sh full",
    "validate:staging": "./scripts/validate.sh staging",
    "validate:production": "./scripts/validate.sh production",
    "validate:circular": "./scripts/validate.sh circular",
    "validate:types": "./scripts/validate.sh types",
    "validate:env": "./scripts/validate.sh env",
    "validate:size": "./scripts/validate.sh size",
    "validate:unused": "./scripts/validate.sh unused",
    "workflow": "./scripts/workflow.sh",
    "workflow:push-merge": "./scripts/workflow.sh push-merge",
    "workflow:deploy": "./scripts/workflow.sh deploy",
    "workflow:soak": "./scripts/workflow.sh soak",
    "workflow:timed": "./scripts/workflow.sh timed",
    "=====Database=====": "=====+=====+=====+=====+=====",
    "db:generate:unsafe": "rm -rf ./drizzle/* && drizzle-kit generate --config=drizzle.config.ts",
    "db:generate:safe": "pnpm db:backup-triggers && pnpm db:generate:unsafe && pnpm db:restore-triggers && echo '✅ Safe generation completed - triggers preserved'",
    "db:backup-triggers": "if [ -f drizzle/000_optimized_triggers_and_constraints.sql ]; then cp drizzle/000_optimized_triggers_and_constraints.sql drizzle/000_optimized_triggers_and_constraints.sql.backup; else echo 'No triggers file to backup'; fi",
    "db:restore-triggers": "if [ -f drizzle/000_optimized_triggers_and_constraints.sql.backup ]; then cp drizzle/000_optimized_triggers_and_constraints.sql.backup drizzle/000_optimized_triggers_and_constraints.sql && rm drizzle/000_optimized_triggers_and_constraints.sql.backup; else echo 'No triggers backup to restore'; fi",
    "db:migrate": "tsx scripts/db/database-manager.ts migrate && pnpm db:triggers && pnpm db:test:all-triggers",
    "db:migrate:dry-run": "tsx scripts/db/database-manager.ts migrate --dry-run",
    "db:migrate:prod": "NODE_ENV=production tsx scripts/db/database-manager.ts migrate --env=production",
    "db:migrate:staging": "NODE_ENV=staging tsx scripts/db/database-manager.ts migrate --env=staging",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:pull": "drizzle-kit pull:pg",
    "db:setup": "tsx scripts/db/database-manager.ts setup complete",
    "db:setup:dev": "NODE_ENV=development tsx scripts/db/database-manager.ts setup complete --env=development",
    "db:setup:staging": "NODE_ENV=staging tsx scripts/db/database-manager.ts setup complete --env=staging",
    "db:setup:prod": "NODE_ENV=production tsx scripts/db/database-manager.ts setup complete --env=production",
    "db:setup:test": "NODE_ENV=development tsx scripts/db/database-manager.ts setup complete --env=development --test",
    "db:studio": "drizzle-kit studio",
    "db:test-connection": "tsx scripts/test/test-db-connection.ts --mode=full",
    "db:triggers": "tsx scripts/db/database-manager.ts setup triggers-only",
    "db:triggers:dev": "NODE_ENV=development tsx scripts/db/database-manager.ts setup triggers-only --env=development",
    "db:triggers:staging": "NODE_ENV=staging tsx scripts/db/database-manager.ts setup triggers-only --env=staging",
    "db:triggers:prod": "NODE_ENV=production tsx scripts/db/database-manager.ts setup triggers-only --env=production",
    "db:validate-migrations": "tsx scripts/db/database-manager.ts validate",
    "db:validate-triggers": "tsx scripts/db/database-manager.ts validate-triggers",
    "db:test:all-triggers": "pnpm tsx scripts/tests/test-all-triggers.ts",
    "db:view-migrations": "tsx scripts/db/database-manager.ts view",
    "db:copy-custom-migrations": "tsx scripts/db/database-manager.ts copy-migrations",
    "=====Database Seeding=====": "=====+=====+=====+=====+=====",
    "hard:reset": "pnpm run drop:all && pnpm run pre:seed && pnpm run seed:external",
    "hard:reset:prod": "NODE_ENV=production pnpm hard:reset",
    "hard:reset:staging": "NODE_ENV=staging pnpm hard:reset",
    "hard:reset:internal": "pnpm run truncate:internal && pnpm run seed:internal",
    "hard:reset:all": "pnpm run drop:all && pnpm run pre:seed && pnpm run seed:all",
    "pre:seed": "pnpm run db:generate:safe && pnpm run db:setup && pnpm run db:migrate && pnpm run db:triggers",
    "truncate:internal": "tsx scripts/db/database-manager.ts truncate --scope=internal",
    "truncate:external": "tsx scripts/db/database-manager.ts truncate --scope=external",
    "truncate:all": "tsx scripts/db/database-manager.ts truncate --scope=all",
    "drop:internal": "tsx scripts/db/database-manager.ts drop --scope=internal",
    "drop:external": "tsx scripts/db/database-manager.ts drop --scope=external",
    "drop:all": "tsx scripts/db/database-manager.ts drop --scope=all",
    "seed": "tsx src/lib/db/seed/index.ts",
    "seed:help": "tsx src/lib/db/seed/index.ts --help",
    "seed:external": "tsx src/lib/db/seed/index.ts --external",
    "seed:internal": "tsx src/lib/db/seed/index.ts --internal",
    "seed:all": "tsx src/lib/db/seed/index.ts --all",
    "seed:clear-user": "tsx src/lib/db/seed/index.ts --clear-user",
    "seed:small": "tsx src/lib/db/seed/index.ts --scenario small",
    "seed:medium": "tsx src/lib/db/seed/index.ts --scenario medium",
    "seed:large": "tsx src/lib/db/seed/index.ts --scenario large",
    "seed:custom": "tsx src/lib/db/seed/index.ts --scenario custom",
    "seed:dry-run": "tsx src/lib/db/seed/index.ts --dry-run",
    "=====Legacy Scripts (Deprecated)=====": "=====+=====+=====+=====+=====",
    "ci:preview:legacy": "NODE_ENV=production ./scripts/ci-runner.sh preview",
    "ci:staging:legacy": "NODE_ENV=production ./scripts/ci-runner.sh staging",
    "ci:production:legacy": "NODE_ENV=production ./scripts/ci-runner.sh production",
    "soak:start:legacy": "./scripts/soak-monitor.sh start",
    "soak:monitor:legacy": "./scripts/soak-monitor.sh monitor",
    "soak:rollback:legacy": "./scripts/soak-monitor.sh rollback",
    "=====Soak Testing=====": "=====+=====+=====+=====+=====",
    "soak:test": "./scripts/test-soak.sh",
    "soak:start": "./scripts/soak-monitor.sh start",
    "soak:monitor": "./scripts/soak-monitor.sh monitor",
    "soak:status": "./scripts/soak-monitor.sh status",
    "soak:rollback": "./scripts/soak-monitor.sh rollback",
    "soak:status:legacy": "./scripts/soak-monitor.sh status",
    "soak:test:legacy": "./scripts/soak-monitor.sh start staging 300 && ./scripts/soak-monitor.sh monitor staging 300",
    "deploy:auto:legacy": "./scripts/deployment-manager.sh auto-deploy",
    "deploy:auto:check:legacy": "./scripts/deployment-manager.sh auto-deploy check",
    "deploy:manual:legacy": "./scripts/deployment-manager.sh manual-deploy",
    "deploy:rollback:legacy": "./scripts/deployment-manager.sh rollback",
    "deploy:status:legacy": "./scripts/deployment-manager.sh status",
    "deploy:history:legacy": "./scripts/deployment-manager.sh history",
    "deploy:list:legacy": "./scripts/deployment-manager.sh list",
    "test:ci:legacy": "pnpm test:strict && pnpm test:e2e:sanity",
    "ci:quality-gate:legacy": "./scripts/ci-quality-gate.sh",
    "ci:unit-tests:legacy": "./scripts/ci-unit-tests.sh",
    "ci:e2e-tests:legacy": "./scripts/ci-e2e-tests.sh",
    "ci:e2e:run:legacy": "./scripts/e2e-run.sh basic 'playwright test --project=chromium' 'Chromium CI tests' 300",
    "ci:e2e:run:coverage:legacy": "./scripts/e2e-run.sh coverage 'playwright test tests/e2e/functional/fast.spec.ts' 'Fast E2E Coverage Tests'",
    "ci:e2e:run:coverage:full:legacy": "./scripts/e2e-run.sh coverage-full 'playwright test tests/e2e/functional/full.spec.ts' 'Full E2E Coverage Tests' 7200",
    "ci:e2e:responsive:legacy": "./scripts/e2e-run.sh responsive",
    "ci:e2e:debug:legacy": "./scripts/e2e-debug.sh",
    "ci:validation:basic:legacy": "./scripts/validation-run.sh basic",
    "ci:validation:dev:legacy": "./scripts/validation-run.sh dev",
    "ci:validation:full:legacy": "./scripts/validation-run.sh full",
    "ci:validation:staging:legacy": "./scripts/validation-run.sh staging",
    "ci:validation:production:legacy": "./scripts/validation-run.sh production",
    "push_and_merge:legacy": "./scripts/push-and-merge.sh",
    "push_and_merge:help:legacy": "./scripts/push-and-merge.sh --help",
    "test:generate-results:legacy": "./scripts/generate-test-results.sh",
    "test:generate-results:sanity:legacy": "./scripts/generate-test-results.sh playwright.fast.config.ts",
    "test:generate-results:popular:legacy": "./scripts/generate-test-results.sh playwright.popular.config.ts",
    "test:generate-results:responsive:legacy": "./scripts/generate-test-results.sh playwright.popular.config.ts tests/e2e/functional/responsive.spec.ts",
    "test:failing:legacy": "./scripts/run-failing.sh files",
    "test:failing:sanity:legacy": "./scripts/run-failing.sh files playwright.fast.config.ts line",
    "test:failing:popular:legacy": "./scripts/run-failing.sh files playwright.popular.config.ts line",
    "test:failing:responsive:legacy": "./scripts/run-failing.sh files playwright.popular.config.ts line tests/e2e/functional/responsive.spec.ts",
    "e2e:sanity": "pnpm test:e2e:sanity"
  },
