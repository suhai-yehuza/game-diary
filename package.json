{
  "name": "game-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x.0",
    "pnpm": "10.x.0"
  },
  "scripts": {
    "_development_": "Development commands",
    "dev": "next dev --turbo",
    "start": "next start",
    "_build_clean_": "Build and clean commands",
    "build": "tsx scripts/utils/verify-env.ts --build && next build",
    "build:analyze": "ANALYZE=true pnpm build",
    "build:debug": "DEBUG=true pnpm build",
    "build:size": "pnpm build && npx size-limit",
    "clean:build": "pnpm clean:build:dev",
    "clean:build:dev": "pnpm prebuild && pnpm build && pnpm validate:dev",
    "clean:build:prod": "pnpm prebuild && pnpm build && pnpm validate",
    "clean": "rm -rf .next out coverage src/lib/types/generated tests-results playwright-report .nyc_output dist && mkdir -p coverage",
    "clean:all": "pnpm clean && pnpm clean:deps && pnpm clean:cache",
    "clean:cache": "rm -rf .next/cache .eslintcache && pnpm clean",
    "clean:deps": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml && pnpm install",
    "prebuild": "pnpm clean:all && pnpm validate:soft",
    "_testing_": "Testing commands",
    "test": "vitest run",
    "test:all": "pnpm test:coverage && pnpm test:e2e",
    "test:coverage": "vitest run --coverage && node scripts/print-coverage-link.cjs",
    "test:strict": "vitest run --reporter=verbose --coverage && node scripts/print-coverage-link.cjs",
    "test:all:strict": "pnpm test:strict && pnpm test:e2e:fast",
    "test:ci": "pnpm test:strict && pnpm test:e2e:fast",
    "test:dev": "pnpm test:fast",
    "test:fast": "pnpm test:all:strict",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "_e2e_core_": "E2E Testing - Core",
    "test:e2e": "./scripts/e2e-run-with-coverage.sh 'playwright test' 'All browsers with coverage'",
    "test:e2e:debug": "./scripts/e2e-debug.sh",
    "test:e2e:fast": "./scripts/e2e-run.sh 'playwright test tests/e2e/fast.spec.ts --config=playwright.fast.config.ts' 'Fast development tests'",
    "test:e2e:fast:watch": "./scripts/e2e-run.sh 'playwright test tests/e2e/fast.spec.ts --config=playwright.fast.config.ts --reporter=list --headed' 'Fast development tests (watch mode)'",
    "test:e2e:ui": "./scripts/e2e-run.sh 'playwright test --ui' 'UI mode'",
    "_e2e_coverage_": "E2E Testing - Coverage",
    "test:e2e:coverage": "./scripts/e2e-run-with-coverage.sh 'playwright test' 'All browsers with coverage'",
    "test:e2e:coverage:fast": "./scripts/e2e-run-with-coverage.sh 'playwright test --project=chromium' 'Chromium with coverage'",
    "test:e2e:coverage:html": "rm -rf playwright-report test-results test-results-e2e coverage/e2e && tsx scripts/e2e-coverage-report.ts && open coverage/e2e/coverage-report.html",
    "test:e2e:coverage:report": "rm -rf playwright-report test-results test-results-e2e coverage/e2e && tsx scripts/e2e-coverage-report.ts",
    "_e2e_browsers_": "E2E Testing - Browsers",
    "test:e2e:chromium": "./scripts/e2e-run.sh 'playwright test --project=chromium' 'Chromium'",
    "test:e2e:desktop": "./scripts/e2e-run.sh 'playwright test --project=chromium --project=firefox --project=webkit' 'Desktop browsers'",
    "test:e2e:firefox": "./scripts/e2e-run.sh 'playwright test --project=firefox' 'Firefox'",
    "test:e2e:mobile": "./scripts/e2e-run.sh 'playwright test --project=\"Mobile Chrome\" --project=\"iPhone\"' 'Mobile devices'",
    "test:e2e:safari": "./scripts/e2e-run.sh 'playwright test --project=webkit' 'Safari'",
    "test:e2e:tablet": "./scripts/e2e-run.sh 'playwright test --project=\"Tablet\"' 'Tablet devices'",
    "_e2e_features_": "E2E Testing - Features",
    "test:e2e:cross-browser": "./scripts/e2e-run.sh 'playwright test tests/e2e/cross-browser.spec.ts' 'Cross-browser compatibility'",
    "test:e2e:responsive": "./scripts/e2e-run.sh 'playwright test tests/e2e/responsive.spec.ts' 'Responsive design'",
    "test:e2e:responsive:popular": "./scripts/e2e-run.sh 'playwright test tests/e2e/responsive.spec.ts --config=playwright.popular.config.ts' 'Responsive design (popular browsers only)'",
    "test:e2e:sharded": "./scripts/e2e-run.sh 'playwright test tests/e2e/responsive.spec.ts --config=playwright.popular.config.ts --shard=1/2' 'Sharded responsive tests (part 1)' && ./scripts/e2e-run.sh 'playwright test tests/e2e/responsive.spec.ts --config=playwright.popular.config.ts --shard=2/2' 'Sharded responsive tests (part 2)'",
    "test:e2e:performance": "./scripts/e2e-run.sh 'playwright test tests/e2e/responsive.spec.ts --config=playwright.popular.config.ts --grep=performance' 'Performance-focused tests'",
    "_e2e_optimization_": "E2E Testing - Optimization",
    "test:e2e:optimize": "./scripts/e2e-optimize.sh setup",
    "test:e2e:clean": "./scripts/e2e-optimize.sh clean",
    "test:e2e:monitor": "./scripts/e2e-optimize.sh monitor",
    "test:e2e:analyze": "./scripts/e2e-optimize.sh analyze",
    "_e2e_combined_": "E2E Testing - Combined",
    "test:e2e:all-browsers": "pnpm test:e2e:desktop && pnpm test:e2e:mobile && pnpm test:e2e:tablet",
    "test:e2e:all-viewports": "pnpm test:e2e:responsive && pnpm test:e2e:cross-browser",
    "test:e2e:ci": "pnpm test:e2e:responsive:popular",
    "test:e2e:ci:fast": "pnpm test:e2e:fast",
    "test:e2e:ci:full": "pnpm test:e2e:sharded",
    "test:e2e:ci:performance": "pnpm test:e2e:performance",
    "_e2e_dev_": "E2E Testing - Development",
    "test:e2e:dev": "pnpm test:e2e:fast",
    "test:e2e:dev:watch": "pnpm test:e2e:fast:watch",
    "_e2e_utilities_": "E2E Testing - Utilities",
    "test:e2e:server": "pnpm dev -p 8080",
    "test:e2e:wait": "wait-on http://localhost:8080",
    "test:e2e:install-browsers": "npx playwright install --with-deps",
    "test:e2e:update-browsers": "npx playwright install --with-deps",
    "test:e2e:show-report": "npx playwright show-report",
    "_e2e_smoke_": "E2E Testing - Smoke Tests",
    "test:e2e:smoke": "playwright test tests/e2e/fast.spec.ts --config=playwright.smoke.config.ts",
    "test:e2e:smoke:deployed": "DEPLOYMENT_URL=$VERCEL_URL playwright test tests/e2e/fast.spec.ts --config=playwright.smoke.config.ts",
    "_e2e_debug_": "E2E Testing - Debug",
    "test:e2e:debug:headed": "pnpm playwright test --headed",
    "test:e2e:debug:ui": "pnpm playwright test --ui",
    "test:e2e:debug:playwright": "pnpm playwright test --headed --debug",
    "_e2e_ci_cd_": "E2E Testing - CI/CD Support",
    "test:e2e:pre-deploy": "pnpm test:e2e:responsive:popular && pnpm test:e2e:performance",
    "test:e2e:post-deploy": "pnpm test:e2e:smoke:deployed",
    "test:e2e:load": "pnpm playwright test tests/e2e/responsive.spec.ts --config=playwright.popular.config.ts --project=chromium --workers=3",
    "_timing_": "Timing wrapper scripts",
    "time:validate": "./scripts/time-script.sh validate",
    "time:test:all": "./scripts/time-script.sh test:all",
    "time:clean:build:prod": "./scripts/time-script.sh clean:build:prod",
    "_validation_": "Validation and linting",
    "fix": "pnpm run lint:fix && pnpm run format && pnpm run typecheck",
    "fix:types": "tsx scripts/utils/fix-type-violations.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check . --cache",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 1",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:staged": "lint-staged",
    "typecheck": "tsc --noEmit --incremental",
    "validate": "./scripts/validation-run.sh production",
    "validate:dev": "./scripts/validation-run.sh dev",
    "validate:soft": "./scripts/validation-run.sh soft",
    "validate:with-size": "pnpm validate && pnpm check:size",
    "validate:types": "tsx scripts/utils/validate-types.ts",
    "validate:types:fix": "pnpm run validate:types && pnpm run fix:types",
    "verify": "./scripts/validation-run.sh basic",
    "_database_": "Database commands",
    "db:copy-custom-migrations": "tsx scripts/db/copy-custom-migrations.ts",
    "db:generate": "rm -rf ./drizzle/* && drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "NODE_ENV=development tsx -r dotenv/config scripts/db/apply-migrations.ts development",
    "db:migrate:dry-run": "NODE_ENV=development tsx -r dotenv/config scripts/db/apply-migrations.ts development --dry-run",
    "db:migrate:prod": "NODE_ENV=production tsx -r dotenv/config scripts/db/apply-migrations.ts production",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:pull": "drizzle-kit pull:pg",
    "db:setup": "tsx scripts/db/setup-database.ts --mode=complete",
    "db:setup:dev": "NODE_ENV=development tsx scripts/db/setup-database.ts --mode=complete --environment=development",
    "db:setup:prod": "NODE_ENV=production tsx scripts/db/setup-database.ts --mode=complete --environment=production",
    "db:setup:test": "NODE_ENV=development tsx scripts/db/setup-database.ts --mode=complete --environment=development --test",
    "db:studio": "drizzle-kit studio",
    "db:test-connection": "tsx scripts/test/test-db-connection.ts --mode=full",
    "db:test-connection:basic": "tsx scripts/test/test-db-connection.ts --mode=basic",
    "db:test-migrations": "tsx scripts/test/test-migrations.ts",
    "db:triggers": "tsx scripts/db/setup-database.ts --mode=triggers-only",
    "db:triggers:dev": "NODE_ENV=development tsx scripts/db/setup-database.ts --mode=triggers-only --environment=development",
    "db:triggers:prod": "NODE_ENV=production tsx scripts/db/setup-database.ts --mode=triggers-only --environment=production",
    "db:validate-migrations": "tsx scripts/db/validate-migrations.ts",
    "db:view-migrations": "tsx scripts/db/view-migrations.ts",
    "_codegen_": "GraphQL code generation",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "_analysis_": "Analysis and performance",
    "analyze": "ANALYZE=true next build",
    "analyze:bundle": "npx @next/bundle-analyzer",
    "check:circular": "tsx scripts/utils/check-circular-deps.ts",
    "check:size": "size-limit",
    "check:size:ci": "size-limit || echo 'Size check skipped in CI environment'",
    "check:unused:exports": "tsx scripts/utils/check-unused-exports.ts",
    "perf:build": "NODE_ENV=production ANALYZE=true next build",
    "perf:measure": "tsx scripts/performance/performance-measure.ts",
    "perf:report": "tsx scripts/performance/performance-report.ts",
    "perf:start": "NODE_ENV=production next start",
    "_dependencies_": "Dependency management",
    "deps:audit": "pnpm audit",
    "deps:check": "pnpm outdated",
    "deps:clean": "pnpm store prune",
    "deps:fix": "pnpm audit fix",
    "deps:interactive": "pnpm update -i",
    "deps:manage": "tsx scripts/utils/manage-deps.ts",
    "deps:update": "pnpm update --latest",
    "_git_hooks_": "Git hooks and utilities",
    "postinstall": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run typecheck && pnpm run test:strict",
    "verify-env": "tsx scripts/utils/verify-env.ts"
  },
  "dependencies": {
    "@apollo/client": "3.13.8",
    "@apollo/server": "4.12.2",
    "@as-integrations/next": "3.2.0",
    "@auth/drizzle-adapter": "1.9.1",
    "@auth/upstash-redis-adapter": "2.9.1",
    "@clerk/backend": "2.3.0",
    "@clerk/nextjs": "6.22.0",
    "@graphql-tools/schema": "10.0.23",
    "@graphql-typed-document-node/core": "3.2.0",
    "@heroicons/react": "2.2.0",
    "@hookform/resolvers": "5.1.1",
    "@neondatabase/serverless": "1.0.1",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.12",
    "@tailwindcss/forms": "0.5.10",
    "@tanstack/react-query": "5.80.10",
    "@types/luxon": "3.6.2",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.35.0",
    "@vitest/coverage-v8": "3.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "compression": "1.8.0",
    "dataloader": "2.2.3",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.44.2",
    "drizzle-seed": "0.3.1",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "framer-motion": "12.19.2",
    "graphql-scalars": "1.24.2",
    "graphql-tag": "2.12.6",
    "ioredis": "5.6.1",
    "jose": "6.0.11",
    "lucide-react": "0.518.0",
    "luxon": "3.6.1",
    "natural": "8.1.0",
    "next": "15.3.4",
    "next-auth": "4.24.11",
    "next-themes": "0.4.6",
    "p-limit": "6.2.0",
    "pg": "8.16.3",
    "postgres": "3.4.7",
    "react": "19.1.0",
    "react-datepicker": "8.4.0",
    "react-day-picker": "9.7.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.58.1",
    "react-loading-skeleton": "3.5.0",
    "react-swipeable": "7.0.2",
    "recharts": "2.15.3",
    "sonner": "2.0.5",
    "svix": "1.67.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "use-debounce": "10.0.5",
    "uuid": "11.1.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@babel/preset-typescript": "7.27.1",
    "@eslint/js": "9.29.0",
    "@faker-js/faker": "9.8.0",
    "@graphql-codegen/cli": "5.0.7",
    "@graphql-codegen/schema-ast": "4.1.0",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-graphql-request": "6.3.0",
    "@graphql-codegen/typescript-operations": "4.6.1",
    "@graphql-codegen/typescript-resolvers": "4.5.1",
    "@graphql-tools/utils": "10.8.6",
    "@next/bundle-analyzer": "15.3.4",
    "@next/eslint-plugin-next": "15.3.4",
    "@playwright/test": "1.53.1",
    "@size-limit/preset-app": "11.2.0",
    "@tailwindcss/postcss": "4.1.11",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "1.8.1",
    "@types/dotenv-flow": "3.3.3",
    "@types/express": "5.0.3",
    "@types/glob": "8.1.0",
    "@types/node": "24.0.7",
    "@types/pg": "8.15.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.35.0",
    "@typescript-eslint/parser": "8.35.0",
    "@typescript-eslint/utils": "8.35.0",
    "@vitest/ui": "3.2.4",
    "assert": "2.1.0",
    "autoprefixer": "10.4.21",
    "dotenv": "17.0.0",
    "dotenv-flow": "4.1.0",
    "drizzle-kit": "0.31.1",
    "eslint": "9.29.0",
    "eslint-config-next": "15.3.4",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "glob": "11.0.3",
    "globals": "16.2.0",
    "graphql": "16.11.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "16.1.2",
    "madge": "8.0.0",
    "node-fetch": "3.3.2",
    "path-browserify": "1.0.1",
    "postcss": "8.5.6",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.13",
    "process": "0.11.10",
    "size-limit": "11.2.0",
    "stream-browserify": "3.0.0",
    "stream-http": "3.2.0",
    "tailwindcss": "4.1.11",
    "ts-morph": "26.0.0",
    "ts-node": "10.9.2",
    "ts-prune": "0.10.3",
    "ts-unused-exports": "11.0.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "undici": "7.11.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4",
    "wait-on": "8.0.3"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "glob": "^11.0.0",
      "node-domexception": "^2.0.0",
      "@babel/plugin-proposal-class-properties": "npm:@babel/plugin-transform-class-properties@^7.27.1",
      "@babel/plugin-proposal-object-rest-spread": "npm:@babel/plugin-transform-object-rest-spread@^7.27.7",
      "@esbuild-kit/core-utils": "^3.3.2",
      "@esbuild-kit/esm-loader": "^2.6.5"
    }
  }
}
