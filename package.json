    "path-browserify": "1.0.1",
    "postcss": "8.5.6",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.13",
    "process": "0.11.10",
    "size-limit": "11.2.0",
    "stream-browserify": "3.0.0",
    "stream-http": "3.2.0",
    "tailwindcss": "4.1.10",
    "ts-morph": "26.0.0",
    "ts-node": "10.9.2",
    "ts-prune": "0.10.3",
    "ts-unused-exports": "11.0.1",
    "tsx": "4.20.3",
