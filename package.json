{
  "name": "game-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "ANALYZE=true next build",
    "analyze:bundle": "pnpm @next/bundle-analyzer",
    "prebuild": "pnpm clean:all && pnpm install && pnpm codegen",
    "build": "next build",
    "postbuild": "pnpm format-all && pnpm validate:types",
    "build:staging": "NODE_ENV=staging next build",
    "check-env": "pnpm sync-env && tsx scripts/utils/check-env.ts",
    "check-env:dev": "NODE_ENV=development pnpm check-env",
    "check:circular": "tsx scripts/utils/check-circular-deps.ts",
    "check:dead:code": "tsx scripts/utils/check-dead-code.ts",
    "check:size": "size-limit",
    "check:size:ci": "size-limit || echo 'Size check skipped in CI environment'",
    "check:unused:imports": "pnpm lint --rule 'import/no-unused-modules: error'",
    "ci:prod:dry-run": "CI=true ./scripts/validation-pipeline.sh dry-run",
    "ci:prod:dry-run:fast": "CI=true ./scripts/validation-pipeline.sh dry-run --fast",
    "ci:prod:local:dry-run": "./scripts/validation-pipeline.sh dry-run",
    "ci:prod:local:dry-run:fast": "./scripts/validation-pipeline.sh dry-run --fast",
    "ci:prod:local:post-deploy": "./scripts/validation-pipeline.sh post-deploy",
    "ci:prod:local:pre-deploy": "./scripts/validation-pipeline.sh pre-deploy",
    "ci:prod:local:validation": "./scripts/validation-pipeline.sh ci",
    "ci:prod:post-deploy": "CI=true ./scripts/validation-pipeline.sh post-deploy",
    "ci:prod:pre-deploy": "CI=true ./scripts/validation-pipeline.sh pre-deploy",
    "ci:prod:validation": "CI=true ./scripts/validation-pipeline.sh ci",
    "clean": "pnpm exec rimraf .next out coverage dist playwright-report .nyc_output src/lib/types/generated tests-results",
    "clean:all": "pnpm clean && pnpm clean:deps && pnpm clean:cache",
    "clean:build": "pnpm check-env:dev && pnpm validate:dev && pnpm deployment:validate",
    "clean:cache": "rm -rf .next/cache .eslintcache",
    "clean:deps": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml && pnpm install",
    "codegen": "pnpm exec graphql-codegen --config codegen.ts",
    "codegen:watch": "pnpm exec graphql-codegen --config codegen.ts --watch",
    "coverage:validate": "tsx tests/validate-coverage.ts",
    "db:backup-schema": "latest_schema=$(ls -t src/lib/db/migrations/*.sql 2>/dev/null | head -n 1); if [ -f \"$latest_schema\" ]; then cp \"$latest_schema\" \"$latest_schema.backup\"; else echo 'No schema file to backup'; fi",
    "db:copy-custom-migrations": "tsx scripts/db/database-manager.ts copy-migrations",
    "db:encrypt-users": "tsx scripts/db/encrypt-existing-users.ts",
    "db:generate:dev": "NODE_ENV=development pnpm exec drizzle-kit generate --config=drizzle.config.ts",
    "db:generate:prod": "NODE_ENV=production pnpm exec drizzle-kit generate --config=drizzle.config.ts",
    "db:generate:safe": "pnpm db:backup-schema && pnpm db:generate:unsafe && pnpm db:restore-schema && echo '✅ Safe generation completed - schema preserved'",
    "db:generate:unsafe": "NODE_ENV=development rm -rf ./drizzle/* && NODE_ENV=development pnpm exec drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "NODE_ENV=development tsx scripts/db/database-manager.ts migrate && NODE_ENV=development pnpm db:triggers && NODE_ENV=development pnpm db:test:all-triggers",
    "db:migrate:dry-run": "tsx scripts/db/database-manager.ts migrate --dry-run",
    "db:migrate:prod": "tsx scripts/db/database-manager.ts migrate --env=production && pnpm db:triggers:prod && pnpm db:test:all-triggers:prod",
    "db:migrate:staging": "NODE_ENV=staging tsx scripts/db/database-manager.ts migrate --env=staging && pnpm db:triggers:staging && pnpm db:test:all-triggers:staging",
    "db:pull": "pnpm exec drizzle-kit pull:pg",
    "db:push": "pnpm exec drizzle-kit push",
    "db:push:force": "pnpm exec drizzle-kit push --force",
    "db:re-encrypt": "tsx scripts/re-encrypt-with-new-key.ts",
    "db:reset": "tsx scripts/db/database-manager.ts reset",
    "db:reset:canonical:dev": "tsx scripts/db/reset-with-env.ts dev",
    "db:reset:canonical:prod": "tsx scripts/db/reset-with-env.ts prod",
    "db:reset:canonical:staging": "tsx scripts/db/reset-with-env.ts staging",
    "db:reset:drizzle:dev": "pnpm db:reset --mode=drizzle --env=dev",
    "db:reset:drizzle:prod": "pnpm db:reset --mode=drizzle --env=prod",
    "db:reset:drizzle:staging": "pnpm db:reset --mode=drizzle --env=staging",
    "db:restore-schema": "latest_backup=$(ls -t src/lib/db/migrations/*.sql.backup 2>/dev/null | head -n 1); if [ -f \"$latest_backup\" ]; then original=\"${latest_backup%.backup}\"; cp \"$latest_backup\" \"$original\" && rm \"$latest_backup\"; else echo 'No schema backup to restore'; fi",
    "db:studio": "pnpm exec drizzle-kit studio",
    "db:test-connection": "tsx scripts/tests/test-db-connection.ts --mode=full",
    "db:test:all-triggers": "NODE_ENV=development pnpm tsx scripts/tests/test-all-triggers.ts",
    "db:test:all-triggers:prod": "NODE_ENV=production pnpm tsx scripts/tests/test-all-triggers.ts --env=production",
    "db:test:all-triggers:staging": "NODE_ENV=staging pnpm tsx scripts/tests/test-all-triggers.ts --env=staging",
    "db:triggers": "tsx scripts/db/database-manager.ts setup triggers-only",
    "db:triggers:dev": "NODE_ENV=development tsx scripts/db/database-manager.ts setup triggers-only --env=development",
    "db:triggers:prod": "NODE_ENV=production tsx scripts/db/database-manager.ts setup triggers-only --env=production",
    "db:triggers:staging": "NODE_ENV=staging tsx scripts/db/database-manager.ts setup triggers-only --env=staging",
    "db:validate-migrations": "tsx scripts/db/database-manager.ts validate",
    "db:validate-triggers": "tsx scripts/db/database-manager.ts validate-triggers",
    "db:view-migrations": "tsx scripts/db/database-manager.ts view",
    "deployment:debug": "./scripts/validation/deployment-debug.sh",
    "deployment:validate": "./scripts/validation/deployment-validate.sh https://staging.game-diary.io https://www.game-diary.io https://game-diary-umber.vercel.app/",
    "deps:audit": "pnpm audit",
    "deps:check": "pnpm outdated",
    "deps:clean": "pnpm store prune",
    "deps:fix": "pnpm audit fix",
    "deps:interactive": "pnpm update -i",
    "deps:manage": "tsx scripts/utils/manage-deps.ts",
    "deps:update": "pnpm update --latest",
    "dev": "pnpm dev:real",
    "dev:interactive": "./scripts/server-manager.sh start --interactive",
    "dev:kill:port": "./scripts/server-manager.sh kill-port",
    "dev:logs": "./scripts/server-manager.sh logs",
    "dev:logs:follow": "./scripts/server-manager.sh logs --follow",
    "dev:mock": "API_MOCK_MODE=true next dev --turbo -p ${PORT:-3000}",
    "dev:real": "next dev --turbo -p ${PORT:-3000}",
    "dev:simple": "./scripts/server-manager.sh start --simple",
    "dev:staging": "NODE_ENV=staging next dev --turbo -p ${PORT:-3001}",
    "dev:start": "./scripts/server-manager.sh start",
    "drop:al": "tsx scripts/db/database-manager.ts drop --scope=all",
    "drop:external": "tsx scripts/db/database-manager.ts drop --scope=external",
    "drop:internal": "tsx scripts/db/database-manager.ts drop --scope=internal",
    "e2e": "./scripts/validation-pipeline.sh dev --skip-db-tests",
    "fix": "pnpm run lint:fix && pnpm run format && pnpm run typecheck",
    "format": "pnpm exec prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format-all": "pnpm codegen && pnpm fix && pnpm format:check && pnpm check:unused:imports && pnpm check:dead:code && pnpm check:circular && pnpm sort-package-json",
    "format:check": "pnpm exec prettier --check . --cache",
    "github:budget": "./scripts/github-actions-budget.sh",
    "hard:reseed:all": "pnpm run db:reset && pnpm run pre:seed && pnpm run seed:all",
    "hard:reseed:dev": "NODE_ENV=development pnpm run db:reset:canonical:dev && NODE_ENV=development pnpm run pre:seed && NODE_ENV=development pnpm run seed:external --env=development",
    "hard:reseed:internal": "pnpm hard:reseed:internal:dev",
    "hard:reseed:internal:dev": "NODE_ENV=development pnpm run truncate:internal && NODE_ENV=development pnpm run seed:internal $@",
    "hard:reseed:internal:prod": "NODE_ENV=production pnpm run truncate:internal && NODE_ENV=production pnpm run seed:internal $@",
    "hard:reseed:internal:staging": "NODE_ENV=staging pnpm run truncate:internal && NODE_ENV=staging pnpm run seed:internal $@",
    "hard:reseed:prod": "NODE_ENV=production pnpm run db:reset:canonical:prod && NODE_ENV=production pnpm run pre:seed:prod && NODE_ENV=production pnpm run seed:external --env=production",
    "hard:reseed:staging": "NODE_ENV=staging pnpm run db:reset:canonical:staging && NODE_ENV=staging pnpm run pre:seed:staging && NODE_ENV=staging pnpm run seed:external --env=staging",
    "postinstall": "husky",
    "key:activate": "tsx scripts/tests/key-management.ts activate",
    "key:create": "tsx scripts/tests/key-management.ts create",
    "key:export-env": "tsx scripts/tests/key-management.ts export-env",
    "key:list": "tsx scripts/tests/key-management.ts list",
    "key:rotate": "tsx scripts/tests/key-management.ts rotate",
    "key:validate": "tsx scripts/tests/key-management.ts validate",
    "lint": "pnpm exec eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 2",
    "lint:fix": "pnpm exec eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:staged": "lint-staged",
    "mock:check": "./scripts/testing/mock-data-helper.sh check",
    "mock:disable": "./scripts/testing/mock-data-helper.sh disable",
    "mock:enable": "./scripts/testing/mock-data-helper.sh enable",
    "mock:list": "./scripts/testing/mock-data-helper.sh list",
    "mock:test": "./scripts/testing/mock-data-helper.sh test",
    "mock:validate": "./scripts/testing/mock-data-helper.sh validate",
    "open:test:report": "pnpm exec playwright show-report",
    "perf:build": "NODE_ENV=production ANALYZE=true next build",
    "perf:measure": "tsx scripts/performance/performance-measure.ts",
    "perf:report": "tsx scripts/performance/performance-report.ts",
    "perf:start": "NODE_ENV=production next start",
    "pre-commit": "echo 'Pre-commit validation is now handled by scripts/db/pre-commit-validation.sh'",
    "pre:seed": "pnpm run db:generate:safe && pnpm run db:migrate && NODE_ENV=development pnpm run db:triggers",
    "pre:seed:prod": "pnpm run db:generate:safe && pnpm run db:migrate:prod && pnpm run db:triggers:prod",
    "pre:seed:staging": "pnpm run db:generate:safe && pnpm run db:migrate:staging && pnpm run db:triggers:staging",
    "push_all": "git checkout syehuza/demo && pnpm clean:build && git push -f && git checkout master && git reset --hard origin/syehuza/demo && git push -f && git checkout staging && git reset --hard origin/syehuza/demo && git push -f && git checkout syehuza/demo",
    "push_and_merge": "./scripts/git/push-and-merge.sh",
    "push_and_merge:help": "./scripts/git/push-and-merge.sh --help",
    "security:key-management": "tsx scripts/tests/key-management.ts validate",
    "security:test-encryption": "tsx scripts/tests/test-encryption.ts",
    "security:test-rls": "tsx scripts/tests/test-rls-policies.ts",
    "security:test-slack-alerting": "tsx scripts/tests/test-slack-alerting.ts",
    "seed": "tsx src/lib/db/seed/index.ts",
    "seed:all": "tsx src/lib/db/seed/index.ts --all",
    "seed:clear-user": "tsx src/lib/db/seed/index.ts --clear-user",
    "seed:custom": "tsx src/lib/db/seed/index.ts --scenario custom",
    "seed:dry-run": "tsx src/lib/db/seed/index.ts --dry-run",
    "seed:external": "tsx src/lib/db/seed/index.ts --external",
    "seed:help": "tsx src/lib/db/seed/index.ts --help",
    "seed:internal": "tsx src/lib/db/seed/index.ts --internal",
    "seed:large": "tsx src/lib/db/seed/index.ts --scenario large",
    "seed:medium": "tsx src/lib/db/seed/index.ts --scenario medium",
    "seed:small": "tsx src/lib/db/seed/index.ts --scenario small",
    "server:unified": "./scripts/server-manager.sh",
    "start": "next start",
    "start:staging": "NODE_ENV=staging next start",
    "sync-env": "tsx scripts/utils/sync-env.ts",
    "test": "pnpm exec vitest run",
    "test:all": "pnpm coverage:validate && pnpm test:e2e:sanity",
    "test:all:strict": "pnpm test:strict && pnpm test:e2e:sanity",
    "test:e2e:auth-protection": "./scripts/validation-pipeline.sh e2e run auth-protection",
    "test:e2e:browser": "./scripts/validation-pipeline.sh e2e run browser",
    "test:e2e:clerk-auth": "./scripts/validation-pipeline.sh e2e run clerk-auth",
    "test:e2e:coverage": "./scripts/validation-pipeline.sh dev --skip-db-tests",
    "test:e2e:critical": "./scripts/validation-pipeline.sh production --fast",
    "test:e2e:cross-browser": "./scripts/validation-pipeline.sh e2e run browser",
    "test:e2e:debug": "./scripts/validation-pipeline.sh dev --skip-db-tests",
    "test:e2e:debug:ui": "pnpm playwright test --ui",
    "test:e2e:fast": "./scripts/validation-pipeline.sh e2e run fast",
    "test:e2e:full": "./scripts/validation-pipeline.sh e2e run full",
    "test:e2e:install-browsers": "./scripts/testing/install-playwright-browsers.sh --verbose",
    "test:e2e:install-browsers:force": "./scripts/testing/install-playwright-browsers.sh --force --verbose",
    "test:e2e:live-games": "./scripts/validation-pipeline.sh e2e run live-games",
    "test:e2e:load": "pnpm exec playwright test tests/e2e/functional/responsive.spec.ts --project=chromium --workers=3",
    "test:e2e:mock-server": "./scripts/validation-pipeline.sh e2e run mock-server",
    "test:e2e:mock-verification": "./scripts/validation-pipeline.sh e2e run mock-verification",
    "test:e2e:navigation": "./scripts/validation-pipeline.sh e2e run navigation",
    "test:e2e:optimize": "./scripts/validation-pipeline.sh dev --skip-db-tests",
    "test:e2e:pages": "./scripts/validation-pipeline.sh e2e run full",
    "test:e2e:pages:auth": "./scripts/validation-pipeline.sh e2e run pages:auth",
    "test:e2e:pages:content": "./scripts/validation-pipeline.sh e2e run pages:content",
    "test:e2e:pages:dashboard": "./scripts/validation-pipeline.sh e2e run pages:dashboard",
    "test:e2e:pages:home": "./scripts/validation-pipeline.sh e2e run pages:home",
    "test:e2e:pages:sports": "./scripts/validation-pipeline.sh e2e run pages:sports",
    "test:e2e:performance": "./scripts/validation-pipeline.sh e2e run performance",
    "test:e2e:post-deploy": "pnpm test:e2e:smoke:deployed",
    "test:e2e:pre-deploy": "./scripts/validation-pipeline.sh production --fast && ./scripts/validation-pipeline.sh e2e run performance",
    "test:e2e:responsive": "./scripts/validation-pipeline.sh dev --skip-db-tests",
    "test:e2e:run": "./scripts/validation-pipeline.sh dev --skip-db-tests",
    "test:e2e:sanity": "./scripts/validation-pipeline.sh e2e run fast",
    "test:e2e:search": "./scripts/validation-pipeline.sh e2e run search",
    "test:e2e:security": "pnpm test:e2e:vercel-auth && pnpm test:e2e:auth-protection && pnpm test:e2e:clerk-auth && pnpm test:webhook && pnpm test:sso",
    "test:e2e:smoke": "./scripts/validation-pipeline.sh e2e run standard",
    "test:e2e:smoke:deployed": "DEPLOYMENT_URL=$VERCEL_URL pnpm exec playwright test tests/e2e/functional/smoke.spec.ts",
    "test:e2e:standard": "./scripts/validation-pipeline.sh e2e run standard",
    "test:e2e:unified": "./scripts/validation-pipeline.sh e2e",
    "test:e2e:vercel-auth": "./scripts/validation-pipeline.sh e2e run vercel-auth",
    "test:integration": "./scripts/testing/integration.sh",
    "test:integration:ci:matrix": "CI=true ./scripts/testing/integration-ci.sh",
    "test:integration:fast": "./scripts/testing/integration.sh --direct-only",
    "test:integration:server": "./scripts/testing/integration.sh --force-server",
    "test:sso": "NODE_ENV=development tsx scripts/tests/test-sso-flow.ts",
    "test:strict": "pnpm exec vitest run --reporter=verbose --coverage",
    "test:unit": "pnpm exec vitest run tests/unit --reporter=verbose --coverage",
    "test:unit:json": "pnpm exec vitest run --reporter=json --coverage",
    "test:unit:ui": "pnpm exec vitest --ui",
    "test:watch": "pnpm exec vitest",
    "test:webhook": "NODE_ENV=development tsx scripts/tests/test-webhook.ts",
    "truncate:all": "tsx scripts/db/database-manager.ts truncate --scope=all",
    "truncate:external": "tsx scripts/db/database-manager.ts truncate --scope=external",
    "truncate:internal": "tsx scripts/db/database-manager.ts truncate --scope=internal",
    "typecheck": "pnpm exec tsc --noEmit --incremental",
    "validate": "./scripts/validation-pipeline.sh",
    "validate:all": "pnpm validate:ci && pnpm db:triggers && pnpm test:e2e:performance",
    "validate:ci": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm db:triggers && pnpm db:test:all-triggers",
    "validate:circular": "./scripts/validation-pipeline.sh circular",
    "validate:dead-code": "./scripts/validation-pipeline.sh dead-code",
    "validate:dev": "./scripts/validation-pipeline.sh dev",
    "validate:dry-run": "./scripts/validation-pipeline.sh dry-run",
    "validate:env": "./scripts/validation-pipeline.sh env",
    "validate:post-deploy": "./scripts/validation-pipeline.sh post-deploy",
    "validate:pre-deploy": "./scripts/validation-pipeline.sh pre-deploy",
    "validate:predeploy": "pnpm validate:ci && pnpm db:triggers && pnpm test:e2e:critical",
    "validate:prod": "./scripts/validation-pipeline.sh production",
    "validate:rapidapi": "./scripts/validation/validate-rapidapi-key.sh",
    "validate:size": "./scripts/validation-pipeline.sh size",
    "validate:staging": "./scripts/validation-pipeline.sh staging",
    "validate:types": "./scripts/validation-pipeline.sh types",
    "validate:unused": "./scripts/validation-pipeline.sh unused",
    "validate:with-size": "pnpm validate && pnpm check:size",
    "verify": "pnpm validate:dev",
    "verify-env": "tsx scripts/utils/verify-env.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
