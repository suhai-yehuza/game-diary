{
  "name": "game-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x.0",
    "pnpm": "10.x.0"
  },
  "scripts": {
    "dev": "next dev --turbo -p ${PORT:-3100}",
    "dev:staging": "NODE_ENV=staging next dev --turbo -p ${PORT:-3101}",
    "start": "next start",
    "start:staging": "NODE_ENV=staging next start",
    "build": "next build",
    "build:staging": "NODE_ENV=staging next build",
    "timed:build": "./scripts/time-script.sh build",
    "clean": "rimraf .next out coverage dist playwright-report .nyc_output src/lib/types/generated tests-results",
    "timed:clean": "./scripts/time-script.sh clean",
    "clean:build": "pnpm clean:build:dev",
    "timed:clean:build": "./scripts/time-script.sh clean:build",
    "clean:build:dev": "./scripts/validation-run.sh dev-build",
    "clean:build:prod": "./scripts/validation-run.sh production",
    "timed:clean:build:prod": "./scripts/time-script.sh clean:build:prod",
    "clean:all": "pnpm clean && pnpm clean:deps && pnpm clean:cache",
    "clean:cache": "rm -rf .next/cache .eslintcache && pnpm clean",
    "clean:deps": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml && pnpm install --frozen-lockfile",
    "prebuild": "pnpm clean:all && pnpm codegen && pnpm fix && pnpm validate:soft",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "timed:lint": "./scripts/time-script.sh lint",
    "typecheck": "tsc --noEmit --incremental",
    "timed:typecheck": "./scripts/time-script.sh typecheck",
    "format:check": "prettier --check . --cache",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "timed:format": "./scripts/time-script.sh format",
    "lint:staged": "lint-staged",
    "fix:lint:format": "pnpm run lint:fix && pnpm run format",
    "fix": "pnpm run fix:lint:format && pnpm run validate:types:fix && pnpm run typecheck && pnpm run fix:lint:format",
    "fix:types": "tsx scripts/utils/fix-type-violations.ts",
    "test": "vitest run",
    "test:all": "pnpm test:coverage && pnpm test:e2e",
    "test:coverage": "vitest run --coverage && node scripts/print-coverage-link.cjs",
    "test:strict": "vitest run --reporter=verbose --coverage && node scripts/print-coverage-link.cjs",
    "test:all:strict": "pnpm test:strict && pnpm test:e2e:fast",
    "test:ci": "pnpm test:strict && pnpm test:e2e:fast",
    "test:e2e:fast": "playwright test --grep @smoke --config=playwright.fast.config.ts",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:unit": "vitest run --reporter=verbose --coverage",
    "timed:test:unit": "./scripts/time-script.sh test:unit",
    "test:e2e:smoke": "playwright test --grep @smoke --config=playwright.fast.config.ts",
    "timed:test:e2e:smoke": "./scripts/time-script.sh test:e2e:smoke",
    "test:e2e:critical": "playwright test --grep @critical --config=playwright.popular.config.ts",
    "timed:test:e2e:critical": "./scripts/time-script.sh test:e2e:critical",
    "test:e2e:full": "playwright test --config=playwright.popular.config.ts",
    "timed:test:e2e:full": "./scripts/time-script.sh test:e2e:full",
    "test:e2e:show-report": "npx playwright show-report",
    "test:e2e:install-browsers": "npx playwright install --with-deps",
    "test:e2e:debug:ui": "pnpm playwright test --ui",
    "test:e2e:smoke:deployed": "DEPLOYMENT_URL=$VERCEL_URL playwright test tests/e2e/fast.spec.ts --config=playwright.smoke.config.ts",
    "test:e2e:pre-deploy": "pnpm test:e2e:responsive:popular && pnpm test:e2e:performance",
    "test:e2e:post-deploy": "pnpm test:e2e:smoke:deployed",
    "test:e2e:load": "pnpm playwright test tests/e2e/responsive.spec.ts --config=playwright.popular.config.ts --project=chromium --workers=3",
    "validate": "./scripts/validation-run.sh production",
    "timed:validate": "./scripts/time-script.sh validate",
    "validate:ci": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "timed:validate:ci": "./scripts/time-script.sh validate:ci",
    "validate:predeploy": "pnpm validate:ci && pnpm test:e2e:smoke",
    "timed:validate:predeploy": "./scripts/time-script.sh validate:predeploy",
    "validate:all": "pnpm validate:ci && pnpm test:e2e:full",
    "timed:validate:all": "./scripts/time-script.sh validate:all",
    "validate:dev": "./scripts/validation-run.sh dev",
    "validate:soft": "./scripts/validation-run.sh soft",
    "validate:with-size": "pnpm validate && pnpm check:size",
    "validate:types": "tsx scripts/utils/validate-types.ts",
    "validate:types:fix": "pnpm run validate:types && pnpm run fix:types",
    "verify": "./scripts/validation-run.sh basic",
    "db:copy-custom-migrations": "tsx scripts/db/copy-custom-migrations.ts",
    "db:generate": "rm -rf ./drizzle/* && drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "NODE_ENV=development tsx -r dotenv/config scripts/db/apply-migrations.ts development",
    "db:migrate:dry-run": "NODE_ENV=development tsx -r dotenv/config scripts/db/apply-migrations.ts development --dry-run",
    "db:migrate:prod": "NODE_ENV=production tsx -r dotenv/config scripts/db/apply-migrations.ts production",
    "db:migrate:staging": "NODE_ENV=staging tsx -r dotenv/config scripts/db/apply-migrations.ts staging",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:pull": "drizzle-kit pull:pg",
    "db:setup": "tsx scripts/db/setup-database.ts --mode=complete",
    "db:setup:dev": "NODE_ENV=development tsx scripts/db/setup-database.ts --mode=complete --environment=development",
    "db:setup:staging": "NODE_ENV=staging tsx scripts/db/setup-database.ts --mode=complete --environment=staging",
    "db:setup:prod": "NODE_ENV=production tsx scripts/db/setup-database.ts --mode=complete --environment=production",
    "db:setup:test": "NODE_ENV=development tsx scripts/db/setup-database.ts --mode=complete --environment=development --test",
    "db:studio": "drizzle-kit studio",
    "db:test-connection": "tsx scripts/test/test-db-connection.ts --mode=full",
    "db:test-connection:basic": "tsx scripts/test/test-db-connection.ts --mode=basic",
    "db:test-migrations": "tsx scripts/test/test-migrations.ts",
    "db:triggers": "tsx scripts/db/setup-database.ts --mode=triggers-only",
    "db:triggers:dev": "NODE_ENV=development tsx scripts/db/setup-database.ts --mode=triggers-only --environment=development",
    "db:triggers:staging": "NODE_ENV=staging tsx scripts/db/setup-database.ts --mode=triggers-only --environment=staging",
    "db:triggers:prod": "NODE_ENV=production tsx scripts/db/setup-database.ts --mode=triggers-only --environment=production",
    "db:validate-migrations": "tsx scripts/db/validate-migrations.ts",
    "db:view-migrations": "tsx scripts/db/view-migrations.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "analyze": "ANALYZE=true next build",
    "analyze:bundle": "npx @next/bundle-analyzer",
    "check:circular": "tsx scripts/utils/check-circular-deps.ts",
    "check:size": "size-limit",
    "check:size:ci": "size-limit || echo 'Size check skipped in CI environment'",
    "check:unused:exports": "tsx scripts/utils/check-unused-exports.ts",
    "perf:build": "NODE_ENV=production ANALYZE=true next build",
    "perf:measure": "tsx scripts/performance/performance-measure.ts",
    "perf:report": "tsx scripts/performance/performance-report.ts",
    "perf:start": "NODE_ENV=production next start",
    "deps:audit": "pnpm audit",
    "deps:check": "pnpm outdated",
    "deps:clean": "pnpm store prune",
    "deps:fix": "pnpm audit fix",
    "deps:interactive": "pnpm update -i",
    "deps:manage": "tsx scripts/utils/manage-deps.ts",
    "deps:update": "pnpm update --latest",
    "postinstall": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run typecheck && pnpm run test:strict",
    "verify-env": "tsx scripts/utils/verify-env.ts",
    "=====Main CI Pipeline Scripts=====": "=====+=====+=====+=====+=====",
    "ci:preview": "./scripts/ci-runner.sh preview",
    "ci:staging": "./scripts/ci-runner.sh staging",
    "ci:production": "./scripts/ci-runner.sh production",
    "=====Individual CI Job Scripts=====": "=====+=====+=====+=====+=====",
    "ci:quality-gate": "./scripts/ci-quality-gate.sh",
    "ci:unit-tests": "./scripts/ci-unit-tests.sh",
    "ci:e2e-tests": "./scripts/ci-e2e-tests.sh",
    "=====Validation Scripts (Legacy Support)=====": "=====+=====+=====+=====+=====",
    "ci:validation:basic": "./scripts/validation-run.sh basic",
    "ci:validation:soft": "./scripts/validation-run.sh soft",
    "ci:validation:full": "./scripts/validation-run.sh full",
    "ci:validation:dev": "./scripts/validation-run.sh dev",
    "ci:validation:dev-build": "./scripts/validation-run.sh dev-build",
    "ci:validation:production": "./scripts/validation-run.sh production",
    "=====E2E Testing Scripts:=====": "=====+=====+=====+=====+=====",
    "ci:e2e:run": "./scripts/e2e-run.sh",
    "ci:e2e:run:coverage": "./scripts/e2e-run-with-coverage.sh",
    "ci:e2e:run:coverage:full": "./scripts/e2e-run-with-coverage-full.sh",
    "ci:e2e:responsive": "./scripts/e2e-responsive.sh",
    "timed:ci:e2e:responsive": "./scripts/time-script.sh ci:e2e:responsive",
    "ci:e2e:debug": "./scripts/e2e-debug.sh",
    "ci:e2e:optimize": "./scripts/e2e-optimize.sh",
    "=====Push and Merge Scripts=====": "=====+=====+=====+=====+=====",
    "push_and_merge": "./scripts/push-and-merge.sh",
    "push_and_merge:help": "./scripts/push-and-merge.sh --help",
    "=====Debug Scripts=====": "=====+=====+=====+=====+=====",
    "test:generate-results": "./scripts/generate-test-results.sh",
    "test:generate-results:fast": "./scripts/generate-test-results.sh playwright.fast.config.ts",
    "test:generate-results:popular": "./scripts/generate-test-results.sh playwright.popular.config.ts",
    "test:generate-results:responsive": "./scripts/generate-test-results.sh playwright.popular.config.ts tests/e2e/responsive.spec.ts",
    "test:failing": "./scripts/run-failing-files.sh",
    "test:failing:fast": "./scripts/run-failing-files.sh playwright.fast.config.ts line",
    "test:failing:popular": "./scripts/run-failing-files.sh playwright.popular.config.ts line",
    "test:failing:responsive": "./scripts/run-failing-files.sh playwright.popular.config.ts line tests/e2e/responsive.spec.ts"
  },
  "dependencies": {
    "@apollo/client": "3.13.8",
    "@apollo/server": "4.12.2",
    "@as-integrations/next": "3.2.0",
    "@auth/drizzle-adapter": "1.9.1",
    "@auth/upstash-redis-adapter": "2.9.1",
    "@clerk/backend": "2.3.0",
    "@clerk/nextjs": "6.23.2",
    "@graphql-tools/schema": "10.0.23",
    "@graphql-typed-document-node/core": "3.2.0",
    "@heroicons/react": "2.2.0",
    "@hookform/resolvers": "5.1.1",
    "@neondatabase/serverless": "1.0.1",
    "@radix-ui/react-dropdown-menu": "2.1.15",
