{
  "name": "game-diary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "// Code Quality": "Scripts for linting, formatting, and type checking",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "fix": "pnpm run lint:fix && pnpm run format && pnpm run typecheck",
    "// Code Analysis": "Scripts for analyzing code structure and usage",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "check:unused:exports": "ts-unused-exports tsconfig.json --allowUnusedTypes --ignoreLocallyUsed --excludePathsFromReport=src --ignoreFiles=.*config.ts --ignoreFiles=codegen.ts --showLineNumber",
    "check:unused:exports:strict": "ts-unused-exports tsconfig.json --allowUnusedTypes --ignoreLocallyUsed",
    "cleanup:unused": "tsx scripts/cleanup-unused.ts",
    "// Validation": "Scripts for comprehensive validation",
    "validate": "pnpm run codegen && pnpm run format && pnpm run fix && pnpm run typecheck && pnpm run check:circular && pnpm run check:unused:exports",
    "// Database Setup": "Primary database setup commands",
    "db:setup": "tsx scripts/setup-database-complete.ts",
    "db:setup:dev": "tsx scripts/setup-database-complete.ts development",
    "db:setup:prod": "tsx scripts/setup-database-complete.ts production",
    "db:setup:test": "tsx scripts/setup-database-complete.ts development --test",
    "// Database Tools": "Database management and inspection tools",
    "db:generate": "rm -rf ./drizzle/* && drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:pull": "drizzle-kit pull:pg",
    "db:studio": "drizzle-kit studio",
    "// Database Triggers": "Trigger management commands",
    "db:triggers": "tsx scripts/setup-database.ts",
    "db:triggers:dev": "tsx scripts/setup-database.ts development",
    "db:triggers:prod": "tsx scripts/setup-database.ts production",
    "// Database Seeding": "Commands for populating the database",
    "db:seed:dev": "tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --seasons=2024 --batchSize=200",
    "db:seed:fast": "tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --batchSize=1000 --concurrency=10",
    "db:seed:prod": "NODE_ENV=production tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --concurrency=20 --batchSize=500",
    "db:seed:test": "NODE_ENV=test tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --seasons=2024 --batchSize=50 --concurrency=2",
    "db:seed:monitor": "tsx --max-old-space-size=24576 src/lib/db/seed/optimized-seeder.ts -- --enableMonitoring=true",
    "// Data Fetching": "Commands for fetching external data",
    "db:fetch-games:dev": "tsx ./src/lib/db/seed/fetch-external-api-games.ts development",
    "db:fetch-games:prod": "tsx ./src/lib/db/seed/fetch-external-api-games.ts production",
    "// Migration Management": "Migration-related commands",
    "db:migrate": "tsx scripts/apply-migrations.ts",
    "db:migrate:dev": "tsx scripts/apply-migrations.ts development",
    "db:migrate:prod": "tsx scripts/apply-migrations.ts production",
    "db:migrate:dry-run": "tsx scripts/apply-migrations.ts development --dry-run",
    "db:copy-custom-migrations": "tsx ./scripts/copy-custom-migrations.ts",
    "db:validate-migrations": "tsx ./scripts/validate-migrations.ts",
    "db:test-migrations": "tsx scripts/test-migrations.ts",
    "db:view-migrations": "tsx ./scripts/view-migrations.ts",
    "// Testing": "Test commands",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:databases": "pnpm test:redis && pnpm test:neon-postgres",
    "test:redis": "tsx scripts/test-redis.ts",
    "test:neon-postgres": "tsx scripts/test-neon-postgres.ts",
    "test:triggers": "tsx src/lib/db/seed/test-trigger.ts",
    "// GraphQL": "GraphQL code generation",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "// Cleanup": "Clean build artifacts and dependencies",
    "clean": "rm -rf .next out coverage .nyc_output && mkdir -p coverage",
    "clean:deps": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml && pnpm install",
    "check:types": "tsc --noEmit --pretty",
    "check:imports": "eslint --no-eslintrc --config .eslintrc.json src/ --ext .ts,.tsx --fix",
    "// Build": "Build commands",
    "prebuild": "pnpm clean && pnpm clean:deps && pnpm codegen && pnpm format && pnpm fix && pnpm check:types && pnpm check:imports",
    "clean:build": "pnpm prebuild && pnpm validate && pnpm build && NODE_ENV=development && pnpm test:databases",
    "prepare": "husky install"
  },
  "dependencies": {
    "@apollo/client": "^3.13.7",
    "@apollo/server": "^4.12.1",
    "@as-integrations/next": "^3.2.0",
