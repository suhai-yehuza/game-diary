{
  "name": "game-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x.0",
    "pnpm": "10.x.0"
  },
  "scripts": {
    "// Development": "Core development commands",
    "dev": "next dev --turbo",
    "build": "tsx scripts/utils/verify-env.ts --build && next build",
    "start": "next start",
    "clean": "rm -rf .next out coverage src/lib/types/generated test-results-e2e playwright-report .nyc_output dist && mkdir -p coverage",
    "clean:deps": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml && pnpm install",
    "clean:cache": "rm -rf .next/cache .eslintcache && pnpm clean",
    "clean:all": "pnpm clean && pnpm clean:deps && pnpm clean:cache",
    "// Code Quality": "Linting, formatting, and type checking",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check . --cache",
    "typecheck": "tsc --noEmit --incremental",
    "fix": "pnpm run lint:fix && pnpm run format && pnpm run typecheck",
    "// Testing": "Test commands",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "trap 'pkill -f \"next dev\" 2>/dev/null || true; pkill -f \"playwright\" 2>/dev/null || true; pkill -f \"firefox\" 2>/dev/null || true; pkill -f \"chromium\" 2>/dev/null || true; pkill -f \"webkit\" 2>/dev/null || true; kill $(lsof -t -i:8080) 2>/dev/null || true; kill $(lsof -t -i:9323) 2>/dev/null || true; pkill -f \"node.*playwright\" 2>/dev/null || true; pkill -f \"npx.*playwright\" 2>/dev/null || true' EXIT; pnpm dev -p 8080 & wait-on http://localhost:8080 && (playwright test | tee /tmp/playwright.log & PLAYWRIGHT_PID=\\$!; (while ! grep -q \"Serving HTML report at http://localhost:9323\" /tmp/playwright.log 2>/dev/null; do sleep 1; done; sleep 2; kill -INT \\$PLAYWRIGHT_PID 2>/dev/null || true))",
    "test:e2e:fast": "trap 'pkill -f \"next dev\" 2>/dev/null || true; pkill -f \"playwright\" 2>/dev/null || true; pkill -f \"firefox\" 2>/dev/null || true; pkill -f \"chromium\" 2>/dev/null || true; pkill -f \"webkit\" 2>/dev/null || true; kill $(lsof -t -i:8080) 2>/dev/null || true; kill $(lsof -t -i:9323) 2>/dev/null || true; pkill -f \"node.*playwright\" 2>/dev/null || true; pkill -f \"npx.*playwright\" 2>/dev/null || true' EXIT; pnpm dev -p 8080 & wait-on http://localhost:8080 && (playwright test --project=chromium | tee /tmp/playwright.log & PLAYWRIGHT_PID=\\$!; (while ! grep -q \"Serving HTML report at http://localhost:9323\" /tmp/playwright.log 2>/dev/null; do sleep 1; done; sleep 2; kill -INT \\$PLAYWRIGHT_PID 2>/dev/null || true))",
    "test:e2e:ui": "trap 'pkill -f \"next dev\" 2>/dev/null || true; kill $(lsof -t -i:8080) 2>/dev/null || true' EXIT; pnpm dev -p 8080 & wait-on http://localhost:8080 && playwright test --ui",
    "test:all": "pnpm test:coverage && pnpm test:e2e",
    "// Database": "Database management commands",
    "db:setup": "tsx scripts/db/setup-database.ts --mode=complete",
    "db:setup:dev": "tsx scripts/db/setup-database.ts --mode=complete --environment=development",
    "db:setup:prod": "tsx scripts/db/setup-database.ts --mode=complete --environment=production",
    "db:setup:test": "tsx scripts/db/setup-database.ts --mode=complete --environment=development --test",
    "db:generate": "rm -rf ./drizzle/* && drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:pull": "drizzle-kit pull:pg",
    "db:studio": "drizzle-kit studio",
    "db:triggers": "tsx scripts/db/setup-database.ts --mode=triggers-only",
    "db:triggers:dev": "tsx scripts/db/setup-database.ts --mode=triggers-only --environment=development",
    "db:triggers:prod": "tsx scripts/db/setup-database.ts --mode=triggers-only --environment=production",
    "db:migrate": "NODE_ENV=development tsx -r dotenv/config scripts/db/apply-migrations.ts development",
    "db:migrate:dev": "NODE_ENV=development tsx -r dotenv/config scripts/db/apply-migrations.ts development",
    "db:migrate:prod": "NODE_ENV=production tsx -r dotenv/config scripts/db/apply-migrations.ts production",
    "db:migrate:dry-run": "NODE_ENV=development tsx -r dotenv/config scripts/db/apply-migrations.ts development --dry-run",
    "db:copy-custom-migrations": "tsx scripts/db/copy-custom-migrations.ts",
    "db:validate-migrations": "tsx scripts/db/validate-migrations.ts",
    "db:test-migrations": "tsx scripts/test/test-migrations.ts",
    "db:test-connection": "tsx scripts/test/test-db-connection.ts --mode=full",
    "db:test-connection:basic": "tsx scripts/test/test-db-connection.ts --mode=basic",
    "db:view-migrations": "tsx scripts/db/view-migrations.ts",
    "// GraphQL": "GraphQL code generation",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "// Analysis": "Code analysis and optimization",
    "analyze": "ANALYZE=true next build",
    "analyze:bundle": "npx @next/bundle-analyzer",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "check:unused:exports": "tsx scripts/utils/check-unused-exports.ts",
    "check:size": "size-limit",
    "// Performance": "Performance monitoring and optimization",
    "perf:build": "NODE_ENV=production ANALYZE=true next build",
    "perf:start": "NODE_ENV=production next start",
    "perf:measure": "tsx scripts/performance/performance-measure.ts",
    "perf:report": "tsx scripts/performance/performance-report.ts",
    "// Validation": "Comprehensive validation suite",
    "validate:types": "tsx scripts/utils/validate-types.ts",
    "fix:types": "tsx scripts/utils/fix-type-violations.ts",
    "validate:types:fix": "pnpm run validate:types && pnpm run fix:types",
    "verify": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run check:circular && pnpm run validate:types:fix && pnpm run verify-env",
    "validate:soft": "pnpm run codegen && pnpm run format && pnpm run fix && pnpm run verify",
    "validate": "pnpm run validate:soft && pnpm run check:unused:exports && pnpm run test:all && pnpm run check:size",
    "// Build": "Build variants and optimization",
    "prebuild": "pnpm clean:all && pnpm validate:soft",
    "build:analyze": "ANALYZE=true pnpm build",
    "build:debug": "DEBUG=true pnpm build",
    "build:size": "pnpm build && npx size-limit",
    "clean:build": "pnpm prebuild && pnpm build && pnpm validate",
    "// Git Hooks": "Pre-commit and pre-push hooks",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run typecheck && pnpm run test:coverage",
    "verify-env": "tsx scripts/utils/verify-env.ts",
    "// Dependencies": "Dependency management commands",
    "deps:check": "pnpm outdated",
    "deps:update": "pnpm update --latest",
    "deps:clean": "pnpm store prune",
    "deps:audit": "pnpm audit",
    "deps:fix": "pnpm audit fix",
    "deps:interactive": "pnpm update -i",
    "deps:manage": "tsx scripts/utils/manage-deps.ts",
    "check": "pnpm lint && pnpm format"
  },
  "dependencies": {
    "@apollo/client": "3.13.8",
    "@apollo/server": "4.12.2",
    "@as-integrations/next": "3.2.0",
    "@auth/drizzle-adapter": "1.9.1",
    "@auth/upstash-redis-adapter": "2.9.1",
    "@clerk/backend": "2.1.0",
    "@clerk/nextjs": "6.22.0",
    "@graphql-tools/schema": "10.0.23",
    "@graphql-typed-document-node/core": "3.2.0",
    "@heroicons/react": "2.2.0",
    "@hookform/resolvers": "5.1.1",
    "@neondatabase/serverless": "1.0.1",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.12",
    "@tailwindcss/forms": "0.5.10",
    "@tanstack/react-query": "5.80.10",
    "@types/luxon": "3.6.2",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.35.0",
    "@vitest/coverage-v8": "3.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "compression": "1.8.0",
    "dataloader": "2.2.3",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.44.2",
    "drizzle-seed": "0.3.1",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "framer-motion": "^12.18.1",
    "graphql-scalars": "1.24.2",
    "graphql-tag": "2.12.6",
    "ioredis": "5.6.1",
    "jose": "6.0.11",
    "lucide-react": "0.518.0",
    "luxon": "3.6.1",
    "natural": "8.1.0",
    "next": "15.3.4",
    "next-auth": "4.24.11",
    "next-themes": "0.4.6",
    "p-limit": "6.2.0",
    "pg": "8.16.2",
    "postgres": "3.4.7",
    "react": "19.1.0",
    "react-datepicker": "8.4.0",
    "react-day-picker": "9.7.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.58.1",
    "react-loading-skeleton": "3.5.0",
    "react-swipeable": "7.0.2",
    "recharts": "2.15.3",
    "sonner": "2.0.5",
    "svix": "1.67.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "use-debounce": "10.0.5",
    "uuid": "11.1.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@babel/preset-typescript": "7.27.1",
    "@eslint/js": "9.29.0",
    "@faker-js/faker": "9.8.0",
    "@graphql-codegen/cli": "5.0.7",
    "@graphql-codegen/schema-ast": "4.1.0",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-graphql-request": "6.3.0",
    "@graphql-codegen/typescript-operations": "4.6.1",
    "@graphql-codegen/typescript-resolvers": "4.5.1",
    "@graphql-tools/utils": "10.8.6",
    "@next/bundle-analyzer": "15.3.4",
    "@next/eslint-plugin-next": "^15.3.4",
    "@playwright/test": "1.53.1",
    "@size-limit/preset-app": "11.2.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "6.6.3",
    "@types/compression": "1.8.1",
    "@types/dotenv-flow": "3.3.3",
    "@types/express": "5.0.3",
    "@types/glob": "^8.1.0",
    "@types/node": "24.0.3",
    "@types/pg": "8.15.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.34.1",
    "@typescript-eslint/parser": "8.34.1",
    "@typescript-eslint/utils": "^8.34.1",
    "@vitest/ui": "3.2.4",
    "assert": "2.1.0",
    "autoprefixer": "10.4.21",
    "dotenv": "16.5.0",
    "dotenv-flow": "4.1.0",
    "drizzle-kit": "0.31.1",
    "eslint": "9.29.0",
    "eslint-config-next": "15.3.4",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "4.4.3",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-import": "2.31.0",
