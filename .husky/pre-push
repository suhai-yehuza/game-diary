#!/usr/bin/env sh

# Run comprehensive pre-push validation
# First, ensure node_modules exists
if [ ! -d "node_modules" ]; then
    echo "⚠️  node_modules not found - installing dependencies..."
    pnpm install
fi

# Skip environment validation if no .env files exist
if [ ! -f ".env.local" ] && [ ! -f ".env" ] && [ ! -f ".env.development" ]; then
    echo "⚠️  No .env files found - skipping environment validation"
    ./scripts/validate.sh ci
else
    ./scripts/validate.sh dev
fi

# Run coverage validation to ensure we meet the 95% threshold
echo "🔍 Running coverage validation..."
if pnpm run test:coverage > /dev/null 2>&1; then
    echo "✅ Coverage validation passed - coverage meets 95% threshold"
else
    echo "❌ Coverage validation failed - coverage is below 95% threshold"
    echo "💡 To fix this:"
    echo "   - Add more unit tests to increase coverage"
    echo "   - Run 'pnpm run test:coverage' to see detailed coverage report"
    echo "   - Focus on files with low coverage percentages"
    exit 1
fi
